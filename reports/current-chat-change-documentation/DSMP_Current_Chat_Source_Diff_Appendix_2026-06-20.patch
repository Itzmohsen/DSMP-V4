++	static boolean parseOutputLine(String line, Result result)
++	{
++		if (line == null)
++		{
++			return false;
++		}
++
++		try
++		{
++			if (line.startsWith(SCORE_PREFIX + "\t"))
++			{
++				String[] fields = line.split("\t", 4);
++				if (fields.length != 4)
++				{
++					return false;
++				}
++				String user = decodeField(fields[1]);
