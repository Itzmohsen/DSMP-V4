+		writer.write(Long.toString(tweetId));
+		writer.write('\t');
+		writer.write(tweetDate);
+		writer.write('\t');
+		writer.write(Long.toString(userId));
+		writer.write('\t');
+		writer.write(userName);
+		writer.write('\t');
+		writer.write(generatedText);
+		writer.write("\r\n");
+	}
