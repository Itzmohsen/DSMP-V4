+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.io.BufferedInputStream;
+import java.io.BufferedOutputStream;
+import java.io.Closeable;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Stores a user's outbound tweet messages off-heap and replays them for every run.
+ */
+final class ReplayableTweetBatchSource implements Closeable
+{
+	private static final int BUFFER_BYTES = 64 * 1024;
+	private static final int MAX_RECORD_BYTES = 16 * 1024 * 1024;
+
+	private final File file;
+	private final int rowCount;
+	private boolean closed;
+
+	private ReplayableTweetBatchSource(File file, int rowCount)
+	{
+		this.file = file;
+		this.rowCount = rowCount;
+	}
+
+	static ReplayableTweetBatchSource create(
+			List<Tweet> tweets,
+			int totalTweetCount,
+			String followeeName) throws IOException
+	{
+		File spoolFile = Files.createTempFile(
+				"dsmp-mobile-tweets-", ".bin").toFile();
+		boolean success = false;
+		int written = 0;
+		try (DataOutputStream output = new DataOutputStream(
+				new BufferedOutputStream(
+						new FileOutputStream(spoolFile), BUFFER_BYTES)))
+		{
+			for (int index = tweets.size() - 1; index >= 0; index--)
+			{
+				Tweet tweet = tweets.get(index);
+				if (tweet == null)
+				{
+					continue;
+				}
+				String message = totalTweetCount
+						+ "\t" + tweet.getUser()
+						+ "\t" + tweet.getTweetId()
+						+ "\t" + followeeName
+						+ "\t" + tweet.getTweetText();
+				byte[] encoded = message.getBytes(StandardCharsets.UTF_8);
+				if (encoded.length > MAX_RECORD_BYTES)
+				{
+					throw new IOException(
+							"Tweet record exceeds the supported transport size: "
+							+ encoded.length + " bytes");
+				}
+				output.writeInt(encoded.length);
+				output.write(encoded);
+				written++;
+			}
+			success = true;
+		}
+		finally
+		{
+			if (!success)
+			{
+				Files.deleteIfExists(spoolFile.toPath());
+			}
+		}
+		spoolFile.deleteOnExit();
+		return new ReplayableTweetBatchSource(spoolFile, written);
+	}
+
+	int size()
+	{
+		return rowCount;
+	}
+
+	Reader openReader() throws IOException
+	{
+		if (closed)
+		{
+			throw new IOException("Tweet source is already closed");
+		}
+		return new Reader(file, rowCount);
+	}
+
+	public void close() throws IOException
+	{
+		if (closed)
+		{
+			return;
+		}
+		closed = true;
+		Files.deleteIfExists(file.toPath());
+	}
+
+	static final class Reader implements Closeable
+	{
+		private final DataInputStream input;
+		private int remainingRows;
+		private boolean closed;
+
+		private Reader(File file, int rowCount) throws IOException
+		{
+			input = new DataInputStream(new BufferedInputStream(
+					new FileInputStream(file), BUFFER_BYTES));
+			remainingRows = rowCount;
+		}
+
+		ArrayList<String> readBatch(int maximumRows) throws IOException
+		{
+			int requested = Math.max(1, maximumRows);
+			ArrayList<String> rows =
+					new ArrayList<String>(Math.min(requested, remainingRows));
+			while (rows.size() < requested && remainingRows > 0)
+			{
+				int length;
+				try
+				{
+					length = input.readInt();
+				}
+				catch (EOFException e)
+				{
+					throw new IOException(
+							"Tweet spool ended before all rows were replayed", e);
+				}
+				if (length < 0 || length > MAX_RECORD_BYTES)
+				{
+					throw new IOException(
+							"Invalid tweet spool record length: " + length);
+				}
+				byte[] encoded = new byte[length];
+				input.readFully(encoded);
+				rows.add(new String(encoded, StandardCharsets.UTF_8));
+				remainingRows--;
+			}
+			return rows;
+		}
+
+		boolean hasRemaining()
+		{
+			return remainingRows > 0;
+		}
+
+		public void close() throws IOException
+		{
+			if (closed)
+			{
+				return;
+			}
+			closed = true;
+			input.close();
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/userRyersonU/RuntimeRelaunchHelper.java b/TwitterGatherDataFollowers/userRyersonU/RuntimeRelaunchHelper.java
new file mode 100644
index 0000000..a6ef157
--- BEFORE/TwitterGatherDataFollowers/userRyersonU/RuntimeRelaunchHelper.java
+++ AFTER/TwitterGatherDataFollowers/userRyersonU/RuntimeRelaunchHelper.java
@@ -0,0 +1,126 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.InputStreamReader;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+
+public final class RuntimeRelaunchHelper
+{
+	private RuntimeRelaunchHelper()
+	{
+	}
+
+	public static void main(String[] args) throws Exception
+	{
+		if (args.length < 2)
+		{
+			throw new IllegalArgumentException(
+					"Expected parent process id and relaunch command.");
+		}
+		long parentPid = Long.parseLong(args[0]);
+		waitForParent(parentPid);
+		Thread.sleep(500L);
+
+		List<String> command = new ArrayList<String>();
+		for (int index = 1; index < args.length; index++)
+		{
+			command.add(args[index]);
+		}
+		new ProcessBuilder(command)
+				.directory(new File(System.getProperty("user.dir")))
+				.inheritIO()
+				.start();
+	}
+
+	private static void waitForParent(long parentPid) throws InterruptedException
+	{
+		while (isProcessAlive(parentPid))
+		{
+			Thread.sleep(200L);
+		}
+	}
+
+	private static boolean isProcessAlive(long processId)
+	{
+		try
+		{
+			Class<?> processHandleClass =
+					Class.forName("java.lang.ProcessHandle");
+			Method ofMethod =
+					processHandleClass.getMethod("of", long.class);
+			Object optionalValue = ofMethod.invoke(null, processId);
+			if (optionalValue instanceof Optional)
+			{
+				Optional<?> process = (Optional<?>)optionalValue;
+				if (!process.isPresent())
+				{
+					return false;
+				}
+				Method isAliveMethod =
+						processHandleClass.getMethod("isAlive");
+				return ((Boolean)isAliveMethod.invoke(
+						process.get())).booleanValue();
+			}
+		}
+		catch (ClassNotFoundException ignored)
+		{
+			return isProcessAliveLegacy(processId);
+		}
+		catch (Exception ignored)
+		{
+			return isProcessAliveLegacy(processId);
+		}
+		return false;
+	}
+
+	private static boolean isProcessAliveLegacy(long processId)
+	{
+		boolean windows = System.getProperty("os.name", "")
+				.toLowerCase().contains("win");
+		try
+		{
+			if (!windows)
+			{
+				return new ProcessBuilder(
+						"/bin/kill",
+						"-0",
+						Long.toString(processId))
+						.start()
+						.waitFor() == 0;
+			}
+
+			Process process = new ProcessBuilder(
+					"cmd",
+					"/c",
+					"tasklist",
+					"/FI",
+					"PID eq " + processId,
+					"/NH")
+					.redirectErrorStream(true)
+					.start();
+			String processIdText = Long.toString(processId);
+			try (BufferedReader reader = new BufferedReader(
+					new InputStreamReader(process.getInputStream())))
+			{
+				String line;
+				while ((line = reader.readLine()) != null)
+				{
+					if (line.contains(processIdText))
+					{
+						return true;
+					}
+				}
+			}
+			process.waitFor();
+		}
+		catch (Exception ignored)
+		{
+			return false;
+		}
+		return false;
+	}
+}

