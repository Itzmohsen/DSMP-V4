+						g2.drawOval(x + w / 2 - 2, y + h / 2 - 2, 4, 4);
+						break;
+					case NODES:
+						g2.drawLine(left + 4, top + 4, right - 4, top + 4);
+						g2.drawLine(left + 4, top + 4, left + 4, bottom - 4);
+						g2.drawLine(right - 4, top + 4, right - 4, bottom - 4);
