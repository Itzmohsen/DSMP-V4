+			drawDecisionLane(g, laneX, changedY, laneW, laneH,
+					"Recommendation changed target",
+					formatCount(analysis.recommendationChangedTargetCount) + " changed",
+					changedRatio,
+					GREEN);
+			drawOutputPanel(g, outputX, canvasY + 50, outputW, canvasH - 82);
