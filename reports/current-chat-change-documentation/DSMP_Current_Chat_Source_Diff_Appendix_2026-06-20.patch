+	private static LinkedHashMap<String,LinkedHashMap<String,Double>>
+			calculateTfidf(
+					LinkedHashMap<String,LinkedHashMap<String,Double>> documents)
+	{
+		LinkedHashMap<String,Integer> documentFrequency =
+				new LinkedHashMap<String,Integer>();
+		for (Map<String,Double> document : documents.values())
+		{
+			for (String term : document.keySet())
+			{
+				Integer frequency = documentFrequency.get(term);
+				documentFrequency.put(
+						term, frequency == null ? 1 : frequency + 1);
+			}
+		}
+
+		int documentCount = documents.size();
+		LinkedHashMap<String,LinkedHashMap<String,Double>> tfidf =
+				new LinkedHashMap<String,LinkedHashMap<String,Double>>();
+		for (Map.Entry<String,LinkedHashMap<String,Double>> entry
+				: documents.entrySet())
+		{
+			LinkedHashMap<String,Double> weighted =
+					new LinkedHashMap<String,Double>();
+			double magnitude = 0.0;
+			for (Map.Entry<String,Double> term : entry.getValue().entrySet())
+			{
+				double df = documentFrequency.get(term.getKey());
+				double idf = Math.log(documentCount / df) / Math.log(2);
+				double value = term.getValue() * idf;
+				if (!Double.isFinite(value))
+				{
+					value = 0.0;
+				}
+				weighted.put(term.getKey(), value);
+				magnitude += value * value;
+			}
+			magnitude = Math.sqrt(magnitude);
+			for (Map.Entry<String,Double> term : weighted.entrySet())
+			{
+				double value = magnitude > 0.0
+						? term.getValue() / magnitude : 0.0;
+				term.setValue(Double.isFinite(value) ? value : 0.0);
+			}
+			tfidf.put(entry.getKey(), weighted);
+		}
+		return tfidf;
+	}
+
+	static List<String> tokenizeForTest(
+			String text,
+			boolean removeHashtags,
+			boolean removeRetweets,
+			boolean removeStopWords)
+	{
+		return tokenize(text, removeHashtags, removeRetweets, removeStopWords);
+	}
+
+	private static List<String> tokenize(
+			String text,
+			boolean removeHashtags,
+			boolean removeRetweets,
+			boolean removeStopWords)
+	{
+		String currentText = text == null ? "" : text;
+		if (currentText.contains("Photo:"))
+		{
+			currentText = currentText.substring(0, currentText.indexOf("Photo:"));
+		}
+		if (currentText.contains("Photoset:"))
+		{
+			currentText = currentText.substring(
+					0, currentText.indexOf("Photoset:"));
+		}
+		if (currentText.contains("RT @") && removeRetweets)
+		{
+			currentText = "";
+		}
+		else
+		{
+			currentText = RETWEET_PATTERN.matcher(currentText).replaceAll("RT ");
+		}
+		currentText = PUNCTUATION_PATTERN.matcher(currentText).replaceAll("");
+		currentText = LINK_PATTERN.matcher(currentText).replaceAll(" ");
+		if (removeHashtags)
+		{
+			currentText = SPECIAL_CHARACTER_PATTERN.matcher(
+					currentText).replaceAll(" ");
+		}
+		currentText = currentText.toLowerCase(Locale.US);
+		if (removeStopWords)
+		{
+			String padded = " " + currentText + " ";
+			for (String stopWord : RecommenderAgent.stopWordsArray)
+			{
+				String pattern = " " + stopWord + " ";
+				if (padded.contains(pattern))
+				{
+					padded = padded.replace(pattern, " ");
+				}
+			}
+			currentText = padded;
+		}
+		currentText = currentText.trim();
+		currentText = NON_ALPHA_PATTERN.matcher(currentText).replaceAll("");
+		currentText = MULTI_SPACE_PATTERN.matcher(currentText).replaceAll(" ");
+		currentText = currentText.trim();
+		if (currentText.length() == 0)
+		{
+			return Collections.emptyList();
+		}
+		return Arrays.asList(currentText.split(" "));
+	}
+
+	private static boolean withinExclusiveDateRange(
+			String tweetDate,
+			String beginDate,
+			String endDate)
+	{
+		SimpleDateFormat format = new SimpleDateFormat("yyyy-MM-dd");
+		try
+		{
+			Date tweet = format.parse(tweetDate);
+			Date begin = format.parse(beginDate);
+			Date end = format.parse(endDate);
+			return begin.before(tweet) && end.after(tweet);
+		}
+		catch (ParseException exception)
+		{
+			return true;
+		}
+	}
+
+	private static void parseDate(String value)
+	{
+		SimpleDateFormat format = new SimpleDateFormat("yyyy-MM-dd");
+		format.setLenient(false);
+		try
+		{
+			format.parse(value);
+		}
+		catch (ParseException exception)
+		{
+			throw new IllegalArgumentException(
+					"Dates must use YYYY-MM-DD: " + value);
+		}
+	}
+
+	private static double sparseCosine(
+			Map<String,Double> first,
+			Map<String,Double> second)
+	{
+		if (first == null || second == null
+				|| first.isEmpty() || second.isEmpty())
+		{
+			return 0.0;
+		}
+		Map<String,Double> smaller = first.size() <= second.size()
+				? first : second;
+		Map<String,Double> larger = smaller == first ? second : first;
+		double score = 0.0;
+		for (Map.Entry<String,Double> entry : smaller.entrySet())
+		{
+			Double other = larger.get(entry.getKey());
+			if (other != null)
+			{
+				score += entry.getValue() * other;
+			}
+		}
+		return score;
+	}
+
+	private static TargetResult buildTargetResult(
+			String target,
+			Map<String,Double> rawScores,
+			int topResults)
+	{
+		ArrayList<Map.Entry<String,Double>> sorted =
+				new ArrayList<Map.Entry<String,Double>>();
+		TreeMap<String,Double> canonical = new TreeMap<String,Double>();
+		for (Map.Entry<String,Double> entry : rawScores.entrySet())
+		{
+			double score = entry.getValue() == null
+					? 0.0 : entry.getValue();
+			if (!Double.isFinite(score))
+			{
+				score = 0.0;
+			}
+			canonical.put(entry.getKey(), score);
+			if (score > 0.0)
+			{
+				sorted.add(new java.util.AbstractMap.SimpleImmutableEntry<String,Double>(
+						entry.getKey(), score));
+			}
+		}
+		Collections.sort(sorted, new Comparator<Map.Entry<String,Double>>()
+		{
+			public int compare(
+					Map.Entry<String,Double> first,
+					Map.Entry<String,Double> second)
+			{
+				int scoreComparison =
+						Double.compare(second.getValue(), first.getValue());
+				return scoreComparison != 0
+						? scoreComparison
+						: first.getKey().compareTo(second.getKey());
+			}
+		});
+		LinkedHashMap<String,Double> top =
+				new LinkedHashMap<String,Double>();
+		for (int index = 0;
+				index < sorted.size() && index < topResults;
+				index++)
+		{
+			Map.Entry<String,Double> entry = sorted.get(index);
+			top.put(entry.getKey(), entry.getValue());
+		}
+		return new TargetResult(target, top, digestScores(target, canonical));
+	}
+
+	private static String digestScores(
+			String target,
+			Map<String,Double> scores)
+	{
+		try
+		{
+			MessageDigest digest = sha256();
+			updateDigest(digest, target);
+			TreeMap<String,Double> ordered =
+					new TreeMap<String,Double>(scores);
+			for (Map.Entry<String,Double> entry : ordered.entrySet())
+			{
+				updateDigest(digest, entry.getKey());
+				updateDigest(digest, Double.doubleToLongBits(entry.getValue()));
+			}
+			return toHex(digest.digest());
+		}
+		catch (RuntimeException exception)
+		{
+			throw exception;
+		}
+	}
+
+	private static String digestResultSet(Map<String,TargetResult> results)
+	{
+		MessageDigest digest = sha256();
+		TreeMap<String,TargetResult> ordered =
+				new TreeMap<String,TargetResult>(results);
+		for (Map.Entry<String,TargetResult> entry : ordered.entrySet())
+		{
+			updateDigest(digest, entry.getKey());
+			updateDigest(digest, entry.getValue().digest);
+		}
+		return toHex(digest.digest());
+	}
+
+	private static void verifyEquivalent(
+			List<String> targets,
+			Map<String,TargetResult> baseline,
+			Map<String,TargetResult> parallel)
+	{
+		if (baseline.size() != parallel.size()
+				|| parallel.size() != targets.size())
+		{
+			throw new IllegalStateException(
+					"Verification failed: result target counts differ.");
+		}
+		for (String target : targets)
+		{
+			TargetResult oneWorker = baseline.get(target);
+			TargetResult manyWorkers = parallel.get(target);
+			if (oneWorker == null || manyWorkers == null)
+			{
+				throw new IllegalStateException(
+						"Verification failed: missing target " + target + ".");
+			}
+			if (!oneWorker.digest.equals(manyWorkers.digest))
+			{
+				throw new IllegalStateException(
+						"Verification failed for target " + target
+								+ ": raw result fingerprints differ.");
+			}
+		}
+	}
+
+	private static List<List<String>> assignRoundRobin(
+			List<String> targets,
+			int workerCount)
+	{
+		ArrayList<List<String>> assignments = new ArrayList<List<String>>();
+		for (int worker = 0; worker < workerCount; worker++)
+		{
+			assignments.add(new ArrayList<String>());
+		}
+		for (int index = 0; index < targets.size(); index++)
+		{
+			assignments.get(index % workerCount).add(targets.get(index));
+		}
+		return assignments;
+	}
+
+	private static int countAssigned(List<List<String>> assignments)
+	{
+		int total = 0;
+		for (List<String> assignment : assignments)
+		{
+			total += assignment.size();
+		}
+		return total;
+	}
+
+	private static long elapsedMillis(long startNanos)
+	{
+		return Math.max(0L, (System.nanoTime() - startNanos) / 1000000L);
+	}
+
+	private static MessageDigest sha256()
+	{
+		try
+		{
+			return MessageDigest.getInstance("SHA-256");
+		}
+		catch (NoSuchAlgorithmException exception)
+		{
+			throw new IllegalStateException("SHA-256 is unavailable.", exception);
+		}
+	}
+
+	private static void updateDigest(MessageDigest digest, String value)
+	{
+		byte[] bytes = value == null
+				? new byte[0] : value.getBytes(StandardCharsets.UTF_8);
+		updateDigest(digest, bytes.length);
+		digest.update(bytes);
+	}
+
+	private static void updateDigest(MessageDigest digest, long value)
+	{
+		digest.update(new byte[] {
+				(byte)(value >>> 56),
+				(byte)(value >>> 48),
+				(byte)(value >>> 40),
+				(byte)(value >>> 32),
+				(byte)(value >>> 24),
+				(byte)(value >>> 16),
+				(byte)(value >>> 8),
+				(byte)value
+		});
+	}
+
+	private static String toHex(byte[] bytes)
+	{
+		StringBuilder output = new StringBuilder(bytes.length * 2);
+		for (byte value : bytes)
+		{
+			output.append(String.format(Locale.US, "%02x", value & 0xff));
+		}
+		return output.toString();
+	}
+
+	private static void deleteRecursively(File file)
+	{
+		if (file == null || !file.exists())
+		{
+			return;
+		}
+		if (file.isDirectory())
+		{
+			File[] children = file.listFiles();
+			if (children != null)
+			{
+				for (File child : children)
+				{
+					deleteRecursively(child);
+				}
+			}
+		}
+		if (!file.delete())
+		{
+			file.deleteOnExit();
+		}
+	}
+
+	private static final class DatasetSnapshot
+	{
+		private final List<String> users;
+		private final LinkedHashMap<String,LinkedHashMap<String,Double>> tfidf;
+		private final LinkedHashMap<String,String> userFollowees;
+		private final String datasetDigest;
+		@SuppressWarnings("unused")
+		private final long inputRows;
+		@SuppressWarnings("unused")
+		private final long acceptedRows;
+		@SuppressWarnings("unused")
+		private final long malformedRows;
+
+		private DatasetSnapshot(
+				List<String> users,
+				LinkedHashMap<String,LinkedHashMap<String,Double>> tfidf,
+				LinkedHashMap<String,String> userFollowees,
+				String datasetDigest,
+				long inputRows,
+				long acceptedRows,
+				long malformedRows)
+		{
+			this.users = users;
+			this.tfidf = tfidf;
+			this.userFollowees = userFollowees;
+			this.datasetDigest = datasetDigest;
+			this.inputRows = inputRows;
+			this.acceptedRows = acceptedRows;
+			this.malformedRows = malformedRows;
+		}
+	}
+
+	private static final class PreparedSvm
+	{
+		private final File directory;
+		private final File trainFile;
+		private final File emptyTestFile;
+		private final TreeSet<String> terms;
+		private final ArrayList<String> classes;
+		private final ArrayList<String> trainUsers;
+		private final LinkedHashMap<String,LinkedHashMap<String,Double>> tfidf;
+		private final LinkedHashMap<String,String> userFollowees;
+
+		private PreparedSvm(
+				File directory,
+				File trainFile,
+				File emptyTestFile,
+				TreeSet<String> terms,
+				ArrayList<String> classes,
+				ArrayList<String> trainUsers,
+				LinkedHashMap<String,LinkedHashMap<String,Double>> tfidf,
+				LinkedHashMap<String,String> userFollowees)
+		{
+			this.directory = directory;
+			this.trainFile = trainFile;
+			this.emptyTestFile = emptyTestFile;
+			this.terms = terms;
+			this.classes = classes;
+			this.trainUsers = trainUsers;
+			this.tfidf = tfidf;
+			this.userFollowees = userFollowees;
+		}
+
+		private void close()
+		{
+			deleteRecursively(directory);
+		}
+	}
+
+	private static final class WorkerResult
+	{
+		private final LinkedHashMap<String,TargetResult> results;
+		private final WorkerMetrics metrics;
+
+		private WorkerResult(
+				LinkedHashMap<String,TargetResult> results,
+				WorkerMetrics metrics)
+		{
+			this.results = results;
+			this.metrics = metrics;
+		}
+	}
+
+	private static final class ExecutionResult
+	{
+		private final LinkedHashMap<String,TargetResult> results;
+		private final List<WorkerMetrics> workers;
+
+		private ExecutionResult(
+				LinkedHashMap<String,TargetResult> results,
+				List<WorkerMetrics> workers)
+		{
+			this.results = results;
+			this.workers = workers;
+		}
+	}
+
+	private static final class NoOpListener implements Listener
+	{
+		public void onPhase(String phase, String detail)
+		{
+		}
+
+		public void onProgress(boolean baseline, int completed, int total)
+		{
+		}
+
+		public void onWorker(
+				int workerIndex,
+				WorkerState state,
+				String target,
+				int completed,
+				int assigned,
+				long elapsedMillis,
+				String detail)
+		{
+		}
+
+		public void onTargetResult(
+				String target,
+				LinkedHashMap<String,Double> scores)
+		{
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/userRyersonU/ExactSvmCorpusAdmission.java b/TwitterGatherDataFollowers/userRyersonU/ExactSvmCorpusAdmission.java
new file mode 100644
index 0000000..b0b9832
--- BEFORE/TwitterGatherDataFollowers/userRyersonU/ExactSvmCorpusAdmission.java
+++ AFTER/TwitterGatherDataFollowers/userRyersonU/ExactSvmCorpusAdmission.java
@@ -0,0 +1,302 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.util.Locale;
+
+/**
+ * Plans exact-SVM retained-corpus execution for the shared JADE JVM.
+ *
+ * When all node maps fit together, the existing in-memory path remains active.
+ * When only one node map fits, nodes use disk-backed execution waves. A run is
+ * rejected only when its largest individual shard cannot fit safely.
+ */
+final class ExactSvmCorpusAdmission
+{
+	private static final long MEBIBYTE = RecommendationMemoryCoordinator.MEBIBYTE;
+	private static final long BASE_RUNTIME_BYTES = 384L * MEBIBYTE;
+	private static final long PER_NODE_RUNTIME_BYTES = 24L * MEBIBYTE;
+	private static final long PER_USER_RUNTIME_BYTES = 8L * 1024L;
+	private static final long PEAK_BYTES_PER_SPARSE_TERM = 240L;
+	private static final long SAFE_HEAP_PERCENT = 78L;
+	private static final long HEAP_RECOMMENDATION_STEP_MB = 512L;
+
+	private ExactSvmCorpusAdmission()
+	{
+	}
+
+	static Profile profile(
+			long retainedSparseTermEntries,
+			int retainedUsers,
+			int requestedNodes)
+	{
+		return profile(
+				retainedSparseTermEntries,
+				retainedUsers,
+				requestedNodes,
+				Runtime.getRuntime().maxMemory());
+	}
+
+	static Profile profile(
+			long retainedSparseTermEntries,
+			int retainedUsers,
+			int requestedNodes,
+			long maximumHeapBytes)
+	{
+		long sparseEntries = Math.max(0L, retainedSparseTermEntries);
+		int users = Math.max(0, retainedUsers);
+		int nodes = Math.max(1, requestedNodes);
+		long maxHeap = Math.max(MEBIBYTE, maximumHeapBytes);
+
+		long estimatedPeak = BASE_RUNTIME_BYTES;
+		estimatedPeak = saturatingAdd(
+				estimatedPeak,
+				saturatingMultiply(nodes, PER_NODE_RUNTIME_BYTES));
+		estimatedPeak = saturatingAdd(
+				estimatedPeak,
+				saturatingMultiply(users, PER_USER_RUNTIME_BYTES));
+		estimatedPeak = saturatingAdd(
+				estimatedPeak,
+				saturatingMultiply(sparseEntries, PEAK_BYTES_PER_SPARSE_TERM));
+
+		long proportionalSafeBudget =
+				saturatingMultiply(maxHeap, SAFE_HEAP_PERCENT) / 100L;
+		long safeBudget = Math.min(
+				maxHeap,
+				Math.max(256L * MEBIBYTE, proportionalSafeBudget));
+		long requiredHeapBytes = divideRoundUp(
+				saturatingMultiply(estimatedPeak, 100L),
+				SAFE_HEAP_PERCENT);
+		long requiredHeapMb = divideRoundUp(requiredHeapBytes, MEBIBYTE);
+		requiredHeapMb = alignUp(
+				requiredHeapMb, HEAP_RECOMMENDATION_STEP_MB);
+
+		return new Profile(
+				sparseEntries,
+				users,
+				nodes,
+				estimatedPeak,
+				safeBudget,
+				requiredHeapMb);
+	}
+
+	static void validate(
+			long retainedSparseTermEntries,
+			int retainedUsers,
+			int requestedNodes)
+	{
+		profile(retainedSparseTermEntries, retainedUsers, requestedNodes)
+				.validate();
+	}
+
+	static WavePlan wavePlan(
+			long totalRetainedSparseTermEntries,
+			long largestNodeSparseTermEntries,
+			int retainedUsers,
+			int requestedNodes)
+	{
+		long maximumHeapBytes = Runtime.getRuntime().maxMemory();
+		return wavePlan(
+				totalRetainedSparseTermEntries,
+				largestNodeSparseTermEntries,
+				retainedUsers,
+				requestedNodes,
+				maximumHeapBytes);
+	}
+
+	static WavePlan wavePlan(
+			long totalRetainedSparseTermEntries,
+			long largestNodeSparseTermEntries,
+			int retainedUsers,
+			int requestedNodes,
+			long maximumHeapBytes)
+	{
+		Profile concurrentProfile = profile(
+				totalRetainedSparseTermEntries,
+				retainedUsers,
+				requestedNodes,
+				maximumHeapBytes);
+		Profile largestNodeProfile = profile(
+				largestNodeSparseTermEntries,
+				retainedUsers,
+				1,
+				maximumHeapBytes);
+		return new WavePlan(concurrentProfile, largestNodeProfile);
+	}
+
+	private static long saturatingAdd(long first, long second)
+	{
+		return first > Long.MAX_VALUE - second
+				? Long.MAX_VALUE : first + second;
+	}
+
+	private static long saturatingMultiply(long first, long second)
+	{
+		if (first <= 0L || second <= 0L)
+		{
+			return 0L;
+		}
+		return first > Long.MAX_VALUE / second
+				? Long.MAX_VALUE : first * second;
+	}
+
+	private static long divideRoundUp(long value, long divisor)
+	{
+		long quotient = value / divisor;
+		return value % divisor == 0L
+				? quotient
+				: saturatingAdd(quotient, 1L);
+	}
+
+	private static long alignUp(long value, long step)
+	{
+		if (value == Long.MAX_VALUE)
+		{
+			return Long.MAX_VALUE;
+		}
+		long remainder = value % step;
+		if (remainder == 0L)
+		{
+			return value;
+		}
+		return value > Long.MAX_VALUE - (step - remainder)
+				? Long.MAX_VALUE : value + step - remainder;
+	}
+
+	static final class Profile
+	{
+		private final long retainedSparseTermEntries;
+		private final int retainedUsers;
+		private final int requestedNodes;
+		private final long estimatedPeakBytes;
+		private final long safeBudgetBytes;
+		private final long requiredHeapMb;
+
+		private Profile(
+				long retainedSparseTermEntries,
+				int retainedUsers,
+				int requestedNodes,
+				long estimatedPeakBytes,
+				long safeBudgetBytes,
+				long requiredHeapMb)
+		{
+			this.retainedSparseTermEntries = retainedSparseTermEntries;
+			this.retainedUsers = retainedUsers;
+			this.requestedNodes = requestedNodes;
+			this.estimatedPeakBytes = estimatedPeakBytes;
+			this.safeBudgetBytes = safeBudgetBytes;
+			this.requiredHeapMb = requiredHeapMb;
+		}
+
+		boolean fits()
+		{
+			return estimatedPeakBytes <= safeBudgetBytes;
+		}
+
+		long getEstimatedPeakMb()
+		{
+			return divideRoundUp(estimatedPeakBytes, MEBIBYTE);
+		}
+
+		long getEstimatedPeakBytes()
+		{
+			return estimatedPeakBytes;
+		}
+
+		long getSafeBudgetMb()
+		{
+			return divideRoundUp(safeBudgetBytes, MEBIBYTE);
+		}
+
+		long getRequiredHeapMb()
+		{
+			return requiredHeapMb;
+		}
+
+		long getRetainedSparseTermEntries()
+		{
+			return retainedSparseTermEntries;
+		}
+
+		void validate()
+		{
+			if (fits())
+			{
+				return;
+			}
+			throw new IllegalArgumentException(
+					"Exact SVM was stopped before agent creation because this text "
+					+ "corpus cannot be retained safely in the current shared Java heap. "
+					+ "The preflight found about "
+					+ String.format(Locale.US, "%,d", retainedSparseTermEntries)
+					+ " per-user term entries across " + requestedNodes
+					+ " recommender node(s) and estimates a peak of "
+					+ RuntimeResourceSettings.formatMegabytes(getEstimatedPeakMb())
+					+ ", while the safe budget is "
+					+ RuntimeResourceSettings.formatMegabytes(getSafeBudgetMb())
+					+ ". Execution waves cannot reduce a single retained group of this "
+					+ "size because its documents must remain available together while "
+					+ "Exact SVM builds TF-IDF and ARFF inputs. Set Maximum Java heap to at least "
+					+ RuntimeResourceSettings.formatMegabytes(requiredHeapMb)
+					+ " and restart, use a smaller corpus, or choose Scalable Linear SVM. "
+					+ "No agents were started and no partial recommendations were accepted.");
+		}
+
+		public String toString()
+		{
+			return "ExactSvmCorpusAdmission.Profile{entries="
+					+ retainedSparseTermEntries
+					+ ", users=" + retainedUsers
+					+ ", nodes=" + requestedNodes
+					+ ", peakMb=" + getEstimatedPeakMb()
+					+ ", safeBudgetMb=" + getSafeBudgetMb()
+					+ ", requiredHeapMb=" + requiredHeapMb + "}";
+		}
+	}
+
+	static final class WavePlan
+	{
+		private final Profile concurrentProfile;
+		private final Profile largestNodeProfile;
+
+		private WavePlan(Profile concurrentProfile, Profile largestNodeProfile)
+		{
+			this.concurrentProfile = concurrentProfile;
+			this.largestNodeProfile = largestNodeProfile;
+		}
+
+		boolean requiresDiskBackedWaves()
+		{
+			return largestNodeProfile.fits() && !concurrentProfile.fits();
+		}
+
+		void validate()
+		{
+			if (largestNodeProfile.fits())
+			{
+				return;
+			}
+			throw new IllegalArgumentException(
+					"Exact SVM was stopped before agent creation because its largest "
+					+ "recommender-node shard cannot fit safely in the current Java heap, "
+					+ "even when nodes execute one at a time. The largest node retains "
+					+ String.format(
+							Locale.US,
+							"about %,d per-user term entries",
+							largestNodeProfile.getRetainedSparseTermEntries())
+					+ " and needs a Java heap of at least "
+					+ RuntimeResourceSettings.formatMegabytes(
+							largestNodeProfile.getRequiredHeapMb())
+					+ ". Increase Maximum Java heap and restart, request more recommender "
+					+ "nodes so each shard is smaller, use a smaller corpus, or choose "
+					+ "Scalable Linear SVM. No agents were started and no partial "
+					+ "recommendations were accepted.");
+		}
+
+		public String toString()
+		{
+			return "ExactSvmCorpusAdmission.WavePlan{concurrent="
+					+ concurrentProfile
+					+ ", largestNode=" + largestNodeProfile
+					+ ", diskBackedWaves=" + requiresDiskBackedWaves() + "}";
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/userRyersonU/ExactSvmCorpusSpool.java b/TwitterGatherDataFollowers/userRyersonU/ExactSvmCorpusSpool.java
new file mode 100644
index 0000000..6186c9b
--- BEFORE/TwitterGatherDataFollowers/userRyersonU/ExactSvmCorpusSpool.java
+++ AFTER/TwitterGatherDataFollowers/userRyersonU/ExactSvmCorpusSpool.java
@@ -0,0 +1,170 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.io.BufferedInputStream;
+import java.io.BufferedOutputStream;
+import java.io.Closeable;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+
+/**
+ * Keeps an Exact-SVM node's normalized corpus off-heap until the node receives
+ * permission to materialize its feature maps.
+ */
+final class ExactSvmCorpusSpool implements Closeable
+{
+	private static final int BUFFER_BYTES = 256 * 1024;
+	private static final int MAX_FIELD_BYTES = 16 * 1024 * 1024;
+
+	private final File file;
+	private DataOutputStream output;
+	private int recordCount;
+	private long normalizedTextBytes;
+	private boolean writingFinished;
+	private boolean closed;
+
+	ExactSvmCorpusSpool() throws IOException
+	{
+		file = Files.createTempFile("dsmp-exact-svm-corpus-", ".bin").toFile();
+		file.deleteOnExit();
+		output = new DataOutputStream(new BufferedOutputStream(
+				new FileOutputStream(file), BUFFER_BYTES));
+	}
+
+	void append(String user, String normalizedText) throws IOException
+	{
+		if (writingFinished || closed)
+		{
+			throw new IOException("Exact-SVM corpus spool is not writable.");
+		}
+		byte[] userBytes = encode(user);
+		byte[] textBytes = encode(normalizedText);
+		output.writeInt(userBytes.length);
+		output.write(userBytes);
+		output.writeInt(textBytes.length);
+		output.write(textBytes);
+		recordCount++;
+		normalizedTextBytes += textBytes.length;
+	}
+
+	void finishWriting() throws IOException
+	{
+		if (writingFinished)
+		{
+			return;
+		}
+		writingFinished = true;
+		if (output != null)
+		{
+			output.close();
+			output = null;
+		}
+	}
+
+	void replay(RecordConsumer consumer) throws IOException
+	{
+		finishWriting();
+		try (DataInputStream input = new DataInputStream(new BufferedInputStream(
+				new FileInputStream(file), BUFFER_BYTES)))
+		{
+			for (int index = 0; index < recordCount; index++)
+			{
+				String user = readField(input);
+				String normalizedText = readField(input);
+				consumer.accept(user, normalizedText);
+			}
+			if (input.read() >= 0)
+			{
+				throw new IOException(
+						"Exact-SVM corpus spool contains unexpected trailing data.");
+			}
+		}
+		catch (EOFException exception)
+		{
+			throw new IOException(
+					"Exact-SVM corpus spool ended before every record was replayed.",
+					exception);
+		}
+	}
+
+	int size()
+	{
+		return recordCount;
+	}
+
+	long normalizedTextBytes()
+	{
+		return normalizedTextBytes;
+	}
+
+	public void close() throws IOException
+	{
+		if (closed)
+		{
+			return;
+		}
+		closed = true;
+		IOException failure = null;
+		if (output != null)
+		{
+			try
+			{
+				output.close();
+			}
+			catch (IOException exception)
+			{
+				failure = exception;
+			}
+			output = null;
+		}
+		try
+		{
+			Files.deleteIfExists(file.toPath());
+		}
+		catch (IOException exception)
+		{
+			failure = exception;
+		}
+		if (failure != null)
+		{
+			throw failure;
+		}
+	}
+
+	private static byte[] encode(String value) throws IOException
+	{
+		byte[] encoded = (value == null ? "" : value)
+				.getBytes(StandardCharsets.UTF_8);
+		if (encoded.length > MAX_FIELD_BYTES)
+		{
+			throw new IOException(
+					"Exact-SVM corpus field exceeds the supported size: "
+					+ encoded.length + " bytes.");
+		}
+		return encoded;
+	}
+
+	private static String readField(DataInputStream input) throws IOException
+	{
+		int length = input.readInt();
+		if (length < 0 || length > MAX_FIELD_BYTES)
+		{
+			throw new IOException(
+					"Invalid Exact-SVM corpus field length: " + length);
+		}
+		byte[] encoded = new byte[length];
+		input.readFully(encoded);
+		return new String(encoded, StandardCharsets.UTF_8);
+	}
+
+	interface RecordConsumer
+	{
+		void accept(String user, String normalizedText) throws IOException;
+	}
+}

