+	private static String compact(String value, int max)
+	{
+		if (value == null)
+		{
+			return "";
+		}
+		String clean = value.replace('\n', ' ').replace('\r', ' ').trim();
+		return clean.length() <= max ? clean : clean.substring(0, Math.max(0, max - 3)) + "...";
+	}
