+ * Exercises the universal corpus through the active sparse distance functions
+ * and the real MLP dimensional structure without launching JADE.
+ */
+public final class UniversalHeavyAlgorithmSmokeTest
+{
+	private UniversalHeavyAlgorithmSmokeTest()
+	{
+	}
+
+	public static void main(String[] args) throws Exception
+	{
+		File file = args.length > 0
+				? new File(args[0])
+				: new File(
+						"Dataset/Benchmarks/"
+						+ "Universal-Heavy-All-Working-Algorithms-76k.txt");
+		Corpus corpus = load(file);
+		validateSimilarityAndKMeansDistances(corpus);
+		validateMlpShape(corpus);
+		System.out.println(
+				"UniversalHeavyAlgorithmSmokeTest passed: "
+				+ corpus.documents.size() + " users, "
+				+ corpus.vocabulary.size() + " features, "
+				+ corpus.classes.size() + " classes.");
+	}
+
+	private static Corpus load(File file) throws Exception
+	{
+		TreeMap<String,LinkedHashMap<String,Double>> documents =
+				new TreeMap<String,LinkedHashMap<String,Double>>();
+		TreeMap<String,String> userClasses = new TreeMap<String,String>();
+		TreeSet<String> vocabulary = new TreeSet<String>();
+		TreeSet<String> classes = new TreeSet<String>();
+		long lineNumber = 0L;
+		try (BufferedReader reader = new BufferedReader(
+				new InputStreamReader(
+						new FileInputStream(file),
+						StandardCharsets.UTF_8),
+				512 * 1024))
+		{
+			String line;
+			while ((line = reader.readLine()) != null)
+			{
+				TwitterGatherDataFollowers.userRyersonU.DatasetRow row =
+						TwitterGatherDataFollowers.userRyersonU.DatasetRow.parse(
+								line, ++lineNumber);
+				userClasses.put(row.userName, row.referenceUser);
+				classes.add(row.referenceUser);
+				LinkedHashMap<String,Double> document =
+						documents.get(row.userName);
+				if (document == null)
+				{
+					document = new LinkedHashMap<String,Double>();
+					documents.put(row.userName, document);
+				}
+				for (String token : row.text.split(" "))
+				{
+					vocabulary.add(token);
+					Double old = document.get(token);
+					document.put(token, old == null ? 1.0 : old + 1.0);
+				}
+			}
+		}
+		require(documents.size() == 480, "unexpected document count");
+		require(vocabulary.size() == 24576, "unexpected feature count");
+		require(classes.size() == 16, "unexpected class count");
+		return new Corpus(documents, userClasses, vocabulary, classes);
+	}
+
+	private static void validateSimilarityAndKMeansDistances(Corpus corpus)
+	{
+		String targetName = "UniversalAuthorC00M00";
+		Point target = point(targetName, corpus);
+		Point sameJournal = point("UniversalAuthorC00M05", corpus);
+		Point unrelated = point("UniversalAuthorC08M00", corpus);
+
+		double sameCosine = target.cosSimDistance(sameJournal);
+		double unrelatedCosine = target.cosSimDistance(unrelated);
+		require(Double.isFinite(sameCosine) && Double.isFinite(unrelatedCosine),
+				"cosine score is not finite");
+		require(sameCosine > unrelatedCosine,
+				"same-journal cosine score is not stronger");
+
+		double sameEuclidean = target.eucliDistance(sameJournal);
+		double unrelatedEuclidean = target.eucliDistance(unrelated);
+		require(Double.isFinite(sameEuclidean)
+						&& Double.isFinite(unrelatedEuclidean),
+				"Euclidean score is not finite");
+		require(sameEuclidean < unrelatedEuclidean,
+				"same-journal Euclidean distance is not closer");
+
+		List<Point> centroids = new ArrayList<Point>();
+		centroids.add(point("UniversalAuthorC00M00", corpus));
+		centroids.add(point("UniversalAuthorC05M00", corpus));
+		centroids.add(point("UniversalAuthorC10M00", corpus));
+		int cosineAssignments = 0;
+		int euclideanAssignments = 0;
+		for (String user : corpus.documents.keySet())
+		{
+			Point candidate = point(user, corpus);
+			double bestCosine = -Double.MAX_VALUE;
+			double bestEuclidean = Double.MAX_VALUE;
+			for (Point centroid : centroids)
+			{
+				double cosine = candidate.cosSimDistance(centroid);
+				double euclidean = candidate.eucliDistance(centroid);
+				require(Double.isFinite(cosine) && Double.isFinite(euclidean),
+						"K-Means distance is not finite for " + user);
+				bestCosine = Math.max(bestCosine, cosine);
+				bestEuclidean = Math.min(bestEuclidean, euclidean);
+			}
+			if (bestCosine > -Double.MAX_VALUE)
+			{
+				cosineAssignments++;
+			}
+			if (bestEuclidean < Double.MAX_VALUE)
+			{
+				euclideanAssignments++;
+			}
+		}
+		require(cosineAssignments == corpus.documents.size(),
+				"cosine K-Means could not assign every user");
+		require(euclideanAssignments == corpus.documents.size(),
+				"Euclidean K-Means could not assign every user");
+	}
+
+	private static void validateMlpShape(Corpus corpus)
+	{
+		List<String> features = new ArrayList<String>(corpus.vocabulary);
+		List<String> classes = new ArrayList<String>(corpus.classes);
+		DataSet data = new DataSet(features.size(), classes.size());
+		TreeSet<String> represented = new TreeSet<String>();
+		for (Map.Entry<String,LinkedHashMap<String,Double>> entry
+				: corpus.documents.entrySet())
+		{
+			String className = corpus.userClasses.get(entry.getKey());
+			if (!represented.add(className))
+			{
+				continue;
+			}
+			double[] input = dense(entry.getValue(), features);
+			double[] output = new double[classes.size()];
+			output[classes.indexOf(className)] = 1.0;
+			data.addRow(new DataSetRow(input, output));
+		}
+		require(data.size() == classes.size(),
+				"MLP smoke data does not represent every class");
+
+		MultiLayerPerceptron model = new MultiLayerPerceptron(
+				TransferFunctionType.TANH,
+				features.size(),
+				10,
+				classes.size());
+		BackPropagation learning = (BackPropagation)model.getLearningRule();
+		learning.setLearningRate(0.1);
+		learning.setMaxError(0.0);
+		learning.setMaxIterations(1);
+		model.learn(data);
+		NeuralNetwork network = model;
+		network.setInput(data.getRowAt(0).getInput());
+		network.calculate();
+		double[] output = network.getOutput();
+		require(output.length == classes.size(),
+				"MLP output dimension changed");
+		for (double value : output)
+		{
+			require(Double.isFinite(value), "MLP produced a non-finite output");
+		}
+	}
+
+	private static Point point(String user, Corpus corpus)
+	{
+		LinkedHashMap<String,Double> values = corpus.documents.get(user);
+		require(values != null, "missing document for " + user);
+		return new Point(user, values);
+	}
+
+	private static double[] dense(
+			Map<String,Double> values,
+			List<String> features)
+	{
+		double[] vector = new double[features.size()];
+		for (int index = 0; index < features.size(); index++)
+		{
+			Double value = values.get(features.get(index));
+			if (value != null)
+			{
+				vector[index] = value.doubleValue();
+			}
+		}
+		return vector;
+	}
+
+	private static void require(boolean condition, String message)
+	{
+		if (!condition)
+		{
+			throw new AssertionError(message);
+		}
+	}
+
+	private static final class Corpus
+	{
+		private final TreeMap<String,LinkedHashMap<String,Double>> documents;
+		private final TreeMap<String,String> userClasses;
+		private final TreeSet<String> vocabulary;
+		private final TreeSet<String> classes;
+
+		private Corpus(
+				TreeMap<String,LinkedHashMap<String,Double>> documents,
+				TreeMap<String,String> userClasses,
+				TreeSet<String> vocabulary,
+				TreeSet<String> classes)
+		{
+			this.documents = documents;
+			this.userClasses = userClasses;
+			this.vocabulary = vocabulary;
+			this.classes = classes;
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/Test/UniversalHeavyDatasetTool.java b/TwitterGatherDataFollowers/Test/UniversalHeavyDatasetTool.java
new file mode 100644
index 0000000..7c0fb0a
--- BEFORE/TwitterGatherDataFollowers/Test/UniversalHeavyDatasetTool.java
+++ AFTER/TwitterGatherDataFollowers/Test/UniversalHeavyDatasetTool.java
@@ -0,0 +1,371 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.TreeSet;
+
+/**
+ * Generates and validates one deterministic, heavy journal-style corpus for
+ * every working non-scalable recommendation algorithm.
+ */
+public final class UniversalHeavyDatasetTool
+{
+	private static final int CLASS_COUNT = 16;
+	private static final int USERS_PER_CLASS = 30;
+	private static final int ROWS_PER_USER = 160;
+	private static final int GROUP_SIZE = 4;
+	private static final int COHORTS_PER_CLASS = 5;
+
+	private static final int CLASS_POOL_SIZE = 512;
+	private static final int GROUP_POOL_SIZE = 512;
+	private static final int COHORT_POOL_SIZE = 128;
+	private static final int NOISE_POOL_SIZE = 4096;
+
+	private static final int CLASS_TERMS_PER_ROW = 8;
+	private static final int GROUP_TERMS_PER_ROW = 4;
+	private static final int COHORT_TERMS_PER_ROW = 4;
+	private static final int NOISE_TERMS_PER_ROW = 16;
+
+	private static final int EXPECTED_USER_COUNT =
+			CLASS_COUNT * USERS_PER_CLASS;
+	private static final long EXPECTED_ROW_COUNT =
+			(long)EXPECTED_USER_COUNT * ROWS_PER_USER;
+	private static final int EXPECTED_VOCABULARY =
+			CLASS_COUNT * CLASS_POOL_SIZE
+			+ (CLASS_COUNT / GROUP_SIZE) * GROUP_POOL_SIZE
+			+ CLASS_COUNT * COHORTS_PER_CLASS * COHORT_POOL_SIZE
+			+ NOISE_POOL_SIZE;
+	private static final int EXPECTED_TERMS_PER_USER =
+			CLASS_POOL_SIZE + GROUP_POOL_SIZE + COHORT_POOL_SIZE
+			+ ROWS_PER_USER * NOISE_TERMS_PER_ROW;
+	private static final File DEFAULT_FILE = new File(
+			"Dataset/Benchmarks/Universal-Heavy-All-Working-Algorithms-76k.txt");
+
+	private UniversalHeavyDatasetTool()
+	{
+	}
+
+	public static void main(String[] args) throws Exception
+	{
+		String command = args.length == 0 ? "generate" : args[0];
+		File file = args.length > 1 ? new File(args[1]) : DEFAULT_FILE;
+		if ("generate".equalsIgnoreCase(command))
+		{
+			generate(file);
+			validate(file);
+			return;
+		}
+		if ("validate".equalsIgnoreCase(command))
+		{
+			validate(file);
+			return;
+		}
+		throw new IllegalArgumentException(
+				"Usage: UniversalHeavyDatasetTool [generate|validate] [dataset]");
+	}
+
+	private static void generate(File file) throws Exception
+	{
+		File parent = file.getParentFile();
+		if (parent != null && !parent.exists() && !parent.mkdirs())
+		{
+			throw new IllegalStateException(
+					"Could not create dataset directory: " + parent);
+		}
+
+		long rowIndex = 0L;
+		try (BufferedWriter writer = new BufferedWriter(
+				new OutputStreamWriter(
+						new FileOutputStream(file),
+						StandardCharsets.UTF_8),
+				512 * 1024))
+		{
+			// Class-major ordering keeps every round-robin node class-balanced.
+			for (int classIndex = 0; classIndex < CLASS_COUNT; classIndex++)
+			{
+				for (int memberIndex = 0;
+						memberIndex < USERS_PER_CLASS; memberIndex++)
+				{
+					int userIndex = classIndex * USERS_PER_CLASS + memberIndex;
+					int groupIndex = classIndex / GROUP_SIZE;
+					int cohortIndex = memberIndex % COHORTS_PER_CLASS;
+					String followee = String.format(
+							"UniversalJournal%02d", classIndex);
+					String user = String.format(
+							"UniversalAuthorC%02dM%02d",
+							classIndex, memberIndex);
+					long userId = 2000000L + userIndex;
+
+					for (int row = 0; row < ROWS_PER_USER; row++)
+					{
+						StringBuilder text = new StringBuilder(720);
+						appendTerms(text, "classword",
+								classIndex * CLASS_POOL_SIZE,
+								CLASS_POOL_SIZE,
+								row * CLASS_TERMS_PER_ROW,
+								CLASS_TERMS_PER_ROW);
+						appendTerms(text, "groupword",
+								groupIndex * GROUP_POOL_SIZE,
+								GROUP_POOL_SIZE,
+								row * GROUP_TERMS_PER_ROW,
+								GROUP_TERMS_PER_ROW);
+						appendTerms(text, "cohortword",
+								(classIndex * COHORTS_PER_CLASS + cohortIndex)
+										* COHORT_POOL_SIZE,
+								COHORT_POOL_SIZE,
+								row * COHORT_TERMS_PER_ROW,
+								COHORT_TERMS_PER_ROW);
+						for (int slot = 0; slot < NOISE_TERMS_PER_ROW; slot++)
+						{
+							int occurrence = row * NOISE_TERMS_PER_ROW + slot;
+							int noiseIndex = Math.floorMod(
+									userIndex * 193 + occurrence * 257,
+									NOISE_POOL_SIZE);
+							appendToken(
+									text,
+									"noiseword" + letters(noiseIndex));
+						}
+
+						long tweetId = 9000000000000000L + rowIndex;
+						String date = String.format(
+								"2024-%02d-%02d 12:%02d:00",
+								1 + classIndex % 12,
+								1 + (memberIndex + row) % 28,
+								(userIndex * 7 + row) % 60);
+						writer.write(followee);
+						writer.write('\t');
+						writer.write(Long.toString(tweetId));
+						writer.write('\t');
+						writer.write(date);
+						writer.write('\t');
+						writer.write(Long.toString(userId));
+						writer.write('\t');
+						writer.write(user);
+						writer.write('\t');
+						writer.write(text.toString());
+						writer.newLine();
+						rowIndex++;
+					}
+				}
+			}
+		}
+		System.out.println(
+				"Generated " + file.getPath() + " with " + rowIndex
+				+ " rows.");
+	}
+
+	private static void validate(File file) throws Exception
+	{
+		LinkedHashMap<String,String> userClasses =
+				new LinkedHashMap<String,String>();
+		LinkedHashMap<String,Integer> userRows =
+				new LinkedHashMap<String,Integer>();
+		TreeMap<String,Integer> classUsers = new TreeMap<String,Integer>();
+		TreeMap<String,LinkedHashSet<String>> userTerms =
+				new TreeMap<String,LinkedHashSet<String>>();
+		TreeSet<String> vocabulary = new TreeSet<String>();
+		long rows = 0L;
+
+		try (BufferedReader reader = reader(file))
+		{
+			String line;
+			while ((line = reader.readLine()) != null)
+			{
+				DatasetRow row = DatasetRow.parse(line, ++rows);
+				String oldClass = userClasses.put(row.userName, row.referenceUser);
+				if (oldClass != null && !oldClass.equals(row.referenceUser))
+				{
+					throw new AssertionError(
+							"Conflicting journal mapping for " + row.userName);
+				}
+				if (oldClass == null)
+				{
+					increment(classUsers, row.referenceUser);
+					userTerms.put(row.userName, new LinkedHashSet<String>());
+				}
+				increment(userRows, row.userName);
+
+				String[] tokens = row.text.split(" ");
+				require(tokens.length == CLASS_TERMS_PER_ROW
+								+ GROUP_TERMS_PER_ROW
+								+ COHORT_TERMS_PER_ROW
+								+ NOISE_TERMS_PER_ROW,
+						"unexpected token count on row " + rows);
+				for (String token : tokens)
+				{
+					require(token.matches("[a-z]+"),
+							"token will not survive cleaning on row "
+							+ rows + ": " + token);
+					vocabulary.add(token);
+					userTerms.get(row.userName).add(token);
+				}
+			}
+		}
+
+		require(rows == EXPECTED_ROW_COUNT,
+				"unexpected row count: " + rows);
+		require(userClasses.size() == EXPECTED_USER_COUNT,
+				"unexpected user count: " + userClasses.size());
+		require(classUsers.size() == CLASS_COUNT,
+				"unexpected journal count: " + classUsers.size());
+		require(vocabulary.size() == EXPECTED_VOCABULARY,
+				"unexpected vocabulary size: " + vocabulary.size());
+		for (Map.Entry<String,Integer> entry : userRows.entrySet())
+		{
+			require(entry.getValue() == ROWS_PER_USER,
+					"unexpected rows for " + entry.getKey());
+		}
+		for (Map.Entry<String,Integer> entry : classUsers.entrySet())
+		{
+			require(entry.getValue() == USERS_PER_CLASS,
+					"unbalanced journal " + entry.getKey());
+		}
+		for (Map.Entry<String,LinkedHashSet<String>> entry : userTerms.entrySet())
+		{
+			require(entry.getValue().size() == EXPECTED_TERMS_PER_USER,
+					"unexpected document vocabulary for " + entry.getKey()
+					+ ": " + entry.getValue().size());
+		}
+		validateEightNodeClassCoverage(userClasses);
+		validateSemanticStructure(userTerms);
+
+		System.out.println(
+				"Validated " + file.getPath() + ": "
+				+ rows + " rows, " + userClasses.size() + " users, "
+				+ classUsers.size() + " balanced journals, "
+				+ vocabulary.size() + " cleaned vocabulary terms, "
+				+ EXPECTED_TERMS_PER_USER + " unique terms per user.");
+		System.out.println(
+				"Validated eight-node class coverage: every node receives "
+				+ "examples from every journal.");
+	}
+
+	private static void validateEightNodeClassCoverage(
+			LinkedHashMap<String,String> userClasses)
+	{
+		List<Set<String>> nodeClasses = new ArrayList<Set<String>>();
+		for (int node = 0; node < 8; node++)
+		{
+			nodeClasses.add(new TreeSet<String>());
+		}
+		int userIndex = 0;
+		for (String journal : userClasses.values())
+		{
+			nodeClasses.get(userIndex % 8).add(journal);
+			userIndex++;
+		}
+		for (int node = 0; node < nodeClasses.size(); node++)
+		{
+			require(nodeClasses.get(node).size() == CLASS_COUNT,
+					"node " + (node + 1)
+					+ " does not receive every journal class");
+		}
+	}
+
+	private static void validateSemanticStructure(
+			Map<String,LinkedHashSet<String>> userTerms)
+	{
+		Set<String> target = userTerms.get("UniversalAuthorC00M00");
+		Set<String> sameJournal = userTerms.get("UniversalAuthorC00M05");
+		Set<String> sameGroup = userTerms.get("UniversalAuthorC01M00");
+		Set<String> differentGroup = userTerms.get("UniversalAuthorC08M00");
+		int sameJournalOverlap = overlap(target, sameJournal);
+		int sameGroupOverlap = overlap(target, sameGroup);
+		int differentGroupOverlap = overlap(target, differentGroup);
+		require(sameJournalOverlap > sameGroupOverlap,
+				"same-journal documents are not more related than group peers");
+		require(sameGroupOverlap > differentGroupOverlap,
+				"group-related documents are not more related than unrelated peers");
+		System.out.println(
+				"Semantic overlap check: same journal=" + sameJournalOverlap
+				+ ", same group=" + sameGroupOverlap
+				+ ", unrelated=" + differentGroupOverlap + ".");
+	}
+
+	private static int overlap(Set<String> left, Set<String> right)
+	{
+		int overlap = 0;
+		for (String value : left)
+		{
+			if (right.contains(value))
+			{
+				overlap++;
+			}
+		}
+		return overlap;
+	}
+
+	private static void appendTerms(
+			StringBuilder text,
+			String prefix,
+			int base,
+			int range,
+			int offset,
+			int count)
+	{
+		for (int index = 0; index < count; index++)
+		{
+			appendToken(
+					text,
+					prefix + letters(base + Math.floorMod(offset + index, range)));
+		}
+	}
+
+	private static void appendToken(StringBuilder text, String token)
+	{
+		if (text.length() > 0)
+		{
+			text.append(' ');
+		}
+		text.append(token);
+	}
+
+	private static String letters(int value)
+	{
+		StringBuilder result = new StringBuilder();
+		int remaining = value;
+		do
+		{
+			result.append((char)('a' + remaining % 26));
+			remaining = remaining / 26;
+		}
+		while (remaining > 0);
+		return result.reverse().toString();
+	}
+
+	private static BufferedReader reader(File file) throws Exception
+	{
+		return new BufferedReader(
+				new InputStreamReader(
+						new FileInputStream(file),
+						StandardCharsets.UTF_8),
+				512 * 1024);
+	}
+
+	private static <K> void increment(Map<K,Integer> counts, K key)
+	{
+		Integer old = counts.get(key);
+		counts.put(key, old == null ? 1 : old + 1);
+	}
+
+	private static void require(boolean condition, String message)
+	{
+		if (!condition)
+		{
+			throw new AssertionError(message);
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/Test/UniversalHeavyParallelCoreBenchmark.java b/TwitterGatherDataFollowers/Test/UniversalHeavyParallelCoreBenchmark.java
