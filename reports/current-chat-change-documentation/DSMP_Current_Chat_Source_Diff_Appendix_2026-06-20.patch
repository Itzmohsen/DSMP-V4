+++ AFTER/TwitterGatherDataFollowers/Test/RecommendationRunLifecycleSelfTest.java
@@ -0,0 +1,63 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+public final class RecommendationRunLifecycleSelfTest
+{
+	private RecommendationRunLifecycleSelfTest()
+	{
+	}
+
+	public static void main(String[] args)
+	{
+		String firstRunId = RecommendationRunLifecycle.createRunId();
+		String secondRunId = RecommendationRunLifecycle.createRunId();
+		require(!firstRunId.equals(secondRunId), "Run IDs must be unique");
+
+		RecommendationRunLifecycle lifecycle = new RecommendationRunLifecycle();
+		require(lifecycle.admit(firstRunId)
+				== RecommendationRunLifecycle.Admission.NEW_RUN,
+				"The first message must open a new run");
+		require(lifecycle.admit(firstRunId)
+				== RecommendationRunLifecycle.Admission.CURRENT_RUN,
+				"Messages from the active run must remain current");
+
+		require(!lifecycle.markTextProcessingCompleteIfReady(99, 100),
+				"Text processing started before all expected records arrived");
+		require(!lifecycle.markTextProcessingCompleteIfReady(100, 100),
+				"Text processing started before every producer completed delivery");
+		require(lifecycle.markInputDeliveryComplete(firstRunId),
+				"The active run rejected its input-delivery barrier");
+		require(lifecycle.isInputDeliveryComplete(),
+				"The active run did not retain its input-delivery barrier");
+		require(!lifecycle.markInputDeliveryComplete(firstRunId),
+				"A duplicate input-delivery barrier was accepted twice");
+		require(lifecycle.markTextProcessingCompleteIfReady(100, 100),
+				"Text processing did not start at the expected threshold");
+		require(!lifecycle.markTextProcessingCompleteIfReady(101, 100),
+				"Text processing was allowed to run more than once");
+
+		require(lifecycle.admit(secondRunId)
+				== RecommendationRunLifecycle.Admission.NEW_RUN,
+				"A different run ID must reset the run gate");
+		require(!lifecycle.isTextProcessingComplete(),
+				"A new run retained the previous completion flag");
+		require(!lifecycle.isInputDeliveryComplete(),
+				"A new run retained the previous input-delivery barrier");
+		require(!lifecycle.markInputDeliveryComplete(firstRunId),
+				"A retired run was allowed to complete input delivery");
+		require(lifecycle.admit(firstRunId)
+				== RecommendationRunLifecycle.Admission.RETIRED_RUN,
+				"Late messages from a completed run were not rejected");
+		require(lifecycle.isActive(secondRunId),
+				"The current run changed after a stale message");
+
+		System.out.println("Recommendation run lifecycle self-test passed");
+	}
+
+	private static void require(boolean condition, String message)
+	{
+		if (!condition)
+		{
+			throw new AssertionError(message);
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/Test/RecommendationScoreMergerSelfTest.java b/TwitterGatherDataFollowers/Test/RecommendationScoreMergerSelfTest.java
new file mode 100644
index 0000000..cb3d3e8
--- BEFORE/TwitterGatherDataFollowers/Test/RecommendationScoreMergerSelfTest.java
+++ AFTER/TwitterGatherDataFollowers/Test/RecommendationScoreMergerSelfTest.java
@@ -0,0 +1,200 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+public final class RecommendationScoreMergerSelfTest
+{
+	private RecommendationScoreMergerSelfTest()
+	{
+	}
+
+	public static void main(String[] args) throws Exception
+	{
+		preservesNativeModeResolution();
+		mergesProjectedFolloweesWithMax();
+		mergesClassifierGuidedUsers();
+		sortsTiesDeterministically();
+		reportsEmptyResultsWithoutFakeCandidates();
+		roundTripsPayloadSerialization();
+		System.out.println("RecommendationScoreMergerSelfTest passed");
+	}
+
+	private static void preservesNativeModeResolution()
+	{
+		require(RecommendationModeSupport.resolveCandidateType(
+				RecommendationTargetMode.ALGORITHM_DEFAULT,
+				RecommendationModeSupport.DOC2VEC) == RecommendationCandidateType.USER,
+				"Doc2Vec default no longer resolves to users");
+		require(RecommendationModeSupport.resolveCandidateType(
+				RecommendationTargetMode.ALGORITHM_DEFAULT,
+				RecommendationModeSupport.SVM) == RecommendationCandidateType.FOLLOWEE,
+				"SVM default no longer resolves to followees");
+		require(!RecommendationModeSupport.requiresConvertedPipeline(
+				RecommendationTargetMode.FOLLOWEE_ACCOUNTS,
+				RecommendationModeSupport.SVM),
+				"native SVM followee mode was treated as converted");
+	}
+
+	private static void mergesProjectedFolloweesWithMax()
+	{
+		Map<String,Map<String,Double>> firstScores = scores(
+				"target", values("StoreA", 0.8, "StoreB", 0.5));
+		Map<String,Map<String,Double>> secondScores = scores(
+				"target", values("StoreA", 0.6, "StoreC", 0.4));
+		Map<String,Map<String,String>> firstDetails =
+				new TreeMap<String,Map<String,String>>();
+		firstDetails.put("target", textValues(
+				"StoreA", "Best-matching user: alice",
+				"StoreB", "Best-matching user: bob"));
+		List<RecommendationScorePayload> payloads = Arrays.asList(
+				RecommendationScorePayload.directWithDetails(
+						RecommendationTargetMode.FOLLOWEE_ACCOUNTS,
+						RecommendationCandidateType.FOLLOWEE,
+						RecommendationMergePolicy.MAX,
+						Arrays.asList("target"), firstScores, firstDetails, null),
+				RecommendationScorePayload.direct(
+						RecommendationTargetMode.FOLLOWEE_ACCOUNTS,
+						RecommendationCandidateType.FOLLOWEE,
+						RecommendationMergePolicy.MAX,
+						Arrays.asList("target"), secondScores, null));
+
+		RecommendationResultPayload result =
+				RecommendationScoreMerger.merge(payloads).get("target");
+		require(close(result.getScores().get("StoreA"), 100.0), "MAX merge lost top score");
+		require(close(result.getScores().get("StoreB"), 62.5), "MAX merge changed StoreB");
+		require(close(result.getScores().get("StoreC"), 50.0), "MAX merge changed StoreC");
+		require("Best-matching user: alice".equals(
+				result.getCandidateDetails().get("StoreA")),
+				"projection representative was lost");
+	}
+
+	private static void mergesClassifierGuidedUsers()
+	{
+		Map<String,Map<String,Double>> classScores = scores(
+				"target", values("Retail", 0.8, "Technology", 0.2));
+		Map<String,Map<String,RecommendationCandidateEvidence>> evidence =
+				new TreeMap<String,Map<String,RecommendationCandidateEvidence>>();
+		Map<String,RecommendationCandidateEvidence> candidates =
+				new TreeMap<String,RecommendationCandidateEvidence>();
+		candidates.put("alice", new RecommendationCandidateEvidence("Retail", 0.5));
+		candidates.put("bob", new RecommendationCandidateEvidence("Technology", 1.0));
+		evidence.put("target", candidates);
+
+		RecommendationScorePayload payload =
+				RecommendationScorePayload.classifierGuidedUsers(
+						RecommendationTargetMode.SIMILAR_USERS,
+						Arrays.asList("target"), classScores, evidence,
+						"SVM-guided users", null);
+		RecommendationResultPayload result =
+				RecommendationScoreMerger.merge(Arrays.asList(payload)).get("target");
+
+		require(close(result.getScores().get("alice"), 100.0),
+				"classifier-guided top user changed");
+		require(close(result.getScores().get("bob"), 50.0),
+				"classifier-guided secondary user changed");
+		require("SVM-guided users".equals(result.getResultLabel()),
+				"classifier guidance label was lost");
+	}
+
+	private static void sortsTiesDeterministically()
+	{
+		LinkedHashMap<String,Double> normalized =
+				RecommendationScoreMerger.normalizeAndSort(values("zeta", 1.0, "alpha", 1.0));
+		require("alpha".equals(normalized.keySet().iterator().next()),
+				"equal scores were not sorted by candidate name");
+	}
+
+	private static void reportsEmptyResultsWithoutFakeCandidates()
+	{
+		RecommendationScorePayload payload = RecommendationScorePayload.direct(
+				RecommendationTargetMode.FOLLOWEE_ACCOUNTS,
+				RecommendationCandidateType.FOLLOWEE,
+				RecommendationMergePolicy.MAX,
+				Arrays.asList("target"),
+				scores("target", new TreeMap<String,Double>()),
+				null);
+		RecommendationResultPayload result =
+				RecommendationScoreMerger.merge(Arrays.asList(payload)).get("target");
+		require(result.getStatus() == RecommendationResultStatus.NO_CANDIDATES,
+				"empty result did not report NO_CANDIDATES");
+		require(result.getScores().isEmpty(), "empty result invented a candidate");
+	}
+
+	private static void roundTripsPayloadSerialization() throws Exception
+	{
+		RecommendationScorePayload original = RecommendationScorePayload.direct(
+				RecommendationTargetMode.FOLLOWEE_ACCOUNTS,
+				RecommendationCandidateType.FOLLOWEE,
+				RecommendationMergePolicy.MAX,
+				Arrays.asList("target"),
+				scores("target", values("StoreA", 1.0)),
+				null);
+		ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+		ObjectOutputStream output = new ObjectOutputStream(bytes);
+		output.writeObject(original);
+		output.close();
+		ObjectInputStream input = new ObjectInputStream(
+				new ByteArrayInputStream(bytes.toByteArray()));
+		Object restored = input.readObject();
+		input.close();
+		require(restored instanceof RecommendationScorePayload,
+				"score payload did not survive serialization");
+	}
+
+	private static Map<String,Map<String,Double>> scores(
+			String target, Map<String,Double> values)
+	{
+		Map<String,Map<String,Double>> scores =
+				new TreeMap<String,Map<String,Double>>();
+		scores.put(target, values);
+		return scores;
+	}
+
+	private static LinkedHashMap<String,Double> values(
+			String firstName, double firstScore,
+			String secondName, double secondScore)
+	{
+		LinkedHashMap<String,Double> values = new LinkedHashMap<String,Double>();
+		values.put(firstName, firstScore);
+		values.put(secondName, secondScore);
+		return values;
+	}
+
+	private static LinkedHashMap<String,Double> values(String name, double score)
+	{
+		LinkedHashMap<String,Double> values = new LinkedHashMap<String,Double>();
+		values.put(name, score);
+		return values;
+	}
+
+	private static Map<String,String> textValues(
+			String firstName, String firstValue,
+			String secondName, String secondValue)
+	{
+		Map<String,String> values = new TreeMap<String,String>();
+		values.put(firstName, firstValue);
+		values.put(secondName, secondValue);
+		return values;
+	}
+
+	private static boolean close(Double actual, double expected)
+	{
+		return actual != null && Math.abs(actual - expected) < 0.000001;
+	}
+
+	private static void require(boolean condition, String message)
+	{
+		if (!condition)
+		{
+			throw new AssertionError(message);
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/Test/RecommenderStreamingAggregationSelfTest.java b/TwitterGatherDataFollowers/Test/RecommenderStreamingAggregationSelfTest.java
new file mode 100644
index 0000000..291de01
--- BEFORE/TwitterGatherDataFollowers/Test/RecommenderStreamingAggregationSelfTest.java
+++ AFTER/TwitterGatherDataFollowers/Test/RecommenderStreamingAggregationSelfTest.java
@@ -0,0 +1,262 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import jade.core.Agent;
+
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.regex.Pattern;
+
+public final class RecommenderStreamingAggregationSelfTest
+{
+	private static final Pattern RETWEET_PATTERN = Pattern.compile("RT @");
+	private static final Pattern PUNCTUATION_PATTERN = Pattern.compile("[\\p{P}]");
+	private static final Pattern LINK_PATTERN = Pattern.compile(
+			"http[a-zA-Z0-9]*|bitly[a-zA-Z0-9]*|www[a-zA-Z0-9]*");
+	private static final Pattern SPECIAL_CHARACTER_PATTERN =
+			Pattern.compile("[^a-zA-Z\\p{Z}]");
+	private static final Pattern NON_ALPHA_PATTERN = Pattern.compile("[^a-zA-Z ]");
+	private static final Pattern MULTI_SPACE_PATTERN = Pattern.compile(" +");
+
+	private RecommenderStreamingAggregationSelfTest()
+	{
+	}
+
+	public static void main(String[] args) throws Exception
+	{
+		preservesLegacyPerUserDocuments();
+		diskBackedExactSvmReplaysIdenticalDocuments();
+		System.out.println("RecommenderStreamingAggregationSelfTest passed");
+	}
+
+	@SuppressWarnings("unchecked")
+	private static void preservesLegacyPerUserDocuments() throws Exception
+	{
+		RecommenderAgent agent = new RecommenderAgent();
+		setInt(agent, "algorithmRec", RecommenderAgent.K_MEANS);
+		setInt(agent, "retweetedby_temp", 1);
+		setInt(agent, "hashtags_temp", 1);
+		setInt(agent, "stopWordFlag_temp", 1);
+
+		Class<?> behaviorClass = Class.forName(
+				"TwitterGatherDataFollowers.userRyersonU.RecommenderAgent"
+				+ "$RecommenderServiceBehaviour");
+		Constructor<?> constructor = behaviorClass.getDeclaredConstructor(
+				RecommenderAgent.class, Agent.class);
+		constructor.setAccessible(true);
+		Object behavior = constructor.newInstance(agent, agent);
+		Method aggregate = behaviorClass.getDeclaredMethod(
+				"aggregateReceivedTweet", String.class, String.class);
+		aggregate.setAccessible(true);
+
+		LinkedHashMap<String,LinkedHashMap<String,Double>> expected =
+				new LinkedHashMap<String,LinkedHashMap<String,Double>>();
+		Set<String> expectedTerms = new TreeSet<String>();
+		int expectedUsable = 0;
+		for (Sample sample : Arrays.asList(
+				new Sample("alice", "Alpha beta beta gamma"),
+				new Sample("alice", "the delta echo foxtrot"),
+				new Sample("bob", "RT @name hidden words here"),
+				new Sample("bob", "Photo: hidden words here"),
+				new Sample("bob", "Golf, hotel! india juliet")))
+		{
+			aggregate.invoke(behavior, sample.user, sample.text);
+			if (legacyAdd(expected, expectedTerms, sample))
+			{
+				expectedUsable++;
+			}
+		}
+
+		Field documentsField =
+				RecommenderAgent.class.getDeclaredField("allUserDocuments");
+		documentsField.setAccessible(true);
+		Map<String,LinkedHashMap<String,Double>> actual =
+				(Map<String,LinkedHashMap<String,Double>>)
+						documentsField.get(agent);
+
+		Field termsField =
+				RecommenderAgent.class.getDeclaredField("allUniqueDocTerms");
+		termsField.setAccessible(true);
+		Set<String> actualTerms = (Set<String>) termsField.get(agent);
+
+		Field countField =
+				RecommenderAgent.class.getDeclaredField("usableTweetCount");
+		countField.setAccessible(true);
+		int actualUsable = countField.getInt(agent);
+
+		require(expected.equals(actual),
+				"streaming ingestion changed per-user term frequencies");
+		require(expectedTerms.equals(actualTerms),
+				"streaming ingestion changed the model vocabulary");
+		require(expectedUsable == actualUsable,
+				"streaming ingestion changed the usable-tweet count");
+	}
+
+	private static boolean legacyAdd(
+			Map<String,LinkedHashMap<String,Double>> documents,
+			Set<String> terms,
+			Sample sample)
+	{
+		String currentText = sample.text;
+		if (currentText.contains("Photo:"))
+			currentText = currentText.substring(0,currentText.indexOf("Photo:"));
+		if (currentText.contains("Photoset:"))
+			currentText = currentText.substring(0,currentText.indexOf("Photoset:"));
+		if (currentText.contains("RT @"))
+			currentText = "";
+		else
+			currentText = RETWEET_PATTERN.matcher(currentText).replaceAll("RT ");
+		currentText = PUNCTUATION_PATTERN.matcher(currentText).replaceAll("");
+		currentText = LINK_PATTERN.matcher(currentText).replaceAll(" ");
+		currentText = SPECIAL_CHARACTER_PATTERN.matcher(currentText).replaceAll(" ");
+		currentText = currentText.toLowerCase();
+		currentText = removeStopWords(currentText);
+		currentText = NON_ALPHA_PATTERN.matcher(currentText.trim()).replaceAll("");
+		currentText = MULTI_SPACE_PATTERN.matcher(currentText).replaceAll(" ").trim();
+		if (currentText.length() == 0)
+		{
+			return false;
+		}
+		String[] tokens = currentText.split(" ");
+		if (tokens.length < 3)
+		{
+			return false;
+		}
+
+		LinkedHashMap<String,Double> document = documents.get(sample.user);
+		if (document == null)
+		{
+			document = new LinkedHashMap<String,Double>();
+			documents.put(sample.user, document);
+		}
+		for (String token : tokens)
+		{
+			terms.add(token);
+			Double frequency = document.get(token);
+			document.put(token, frequency == null ? 1.0 : frequency + 1.0);
+		}
+		return true;
+	}
+
+	@SuppressWarnings("unchecked")
+	private static void diskBackedExactSvmReplaysIdenticalDocuments()
+			throws Exception
+	{
+		RecommenderAgent agent = new RecommenderAgent();
+		setInt(agent, "algorithmRec", RecommenderAgent.SVM);
+		setInt(agent, "retweetedby_temp", 1);
+		setInt(agent, "hashtags_temp", 1);
+		setInt(agent, "stopWordFlag_temp", 1);
+		setBoolean(agent, "exactSvmDiskBackedWaves", true);
+
+		Class<?> behaviorClass = Class.forName(
+				"TwitterGatherDataFollowers.userRyersonU.RecommenderAgent"
+				+ "$RecommenderServiceBehaviour");
+		Constructor<?> constructor = behaviorClass.getDeclaredConstructor(
+				RecommenderAgent.class, Agent.class);
+		constructor.setAccessible(true);
+		Object behavior = constructor.newInstance(agent, agent);
+		Method aggregate = behaviorClass.getDeclaredMethod(
+				"aggregateReceivedTweet", String.class, String.class);
+		aggregate.setAccessible(true);
+		Method finish = behaviorClass.getDeclaredMethod(
+				"finishExactSvmCorpusSpoolWriting");
+		finish.setAccessible(true);
+		Method materialize = behaviorClass.getDeclaredMethod(
+				"materializeExactSvmCorpusSpool");
+		materialize.setAccessible(true);
+
+		LinkedHashMap<String,LinkedHashMap<String,Double>> expected =
+				new LinkedHashMap<String,LinkedHashMap<String,Double>>();
+		Set<String> expectedTerms = new TreeSet<String>();
+		for (Sample sample : Arrays.asList(
+				new Sample("alice", "Alpha beta beta gamma"),
+				new Sample("alice", "Delta echo foxtrot"),
+				new Sample("bob", "Golf hotel india juliet")))
+		{
+			aggregate.invoke(behavior, sample.user, sample.text);
+			legacyAdd(expected, expectedTerms, sample);
+		}
+
+		Field documentsField =
+				RecommenderAgent.class.getDeclaredField("allUserDocuments");
+		documentsField.setAccessible(true);
+		Map<String,LinkedHashMap<String,Double>> documentsBeforeReplay =
+				(Map<String,LinkedHashMap<String,Double>>)
+						documentsField.get(agent);
+		require(documentsBeforeReplay.isEmpty(),
+				"disk-backed Exact SVM retained documents before its wave");
+
+		finish.invoke(behavior);
+		materialize.invoke(behavior);
+
+		Map<String,LinkedHashMap<String,Double>> actual =
+				(Map<String,LinkedHashMap<String,Double>>)
+						documentsField.get(agent);
+		Field termsField =
+				RecommenderAgent.class.getDeclaredField("allUniqueDocTerms");
+		termsField.setAccessible(true);
+		Set<String> actualTerms = (Set<String>) termsField.get(agent);
+		require(expected.equals(actual),
+				"disk-backed Exact SVM changed per-user term frequencies");
+		require(expectedTerms.equals(actualTerms),
+				"disk-backed Exact SVM changed the model vocabulary");
+	}
+
+	private static String removeStopWords(String currentText)
+	{
+		String padded = " " + currentText + " ";
+		for (String stopWord : RecommenderAgent.stopWordsArray)
+		{
+			String pattern = " " + stopWord + " ";
+			if (padded.contains(pattern))
+			{
+				padded = padded.replace(pattern, " ");
+			}
+		}
+		return padded;
+	}
+
+	private static void setInt(Object target, String fieldName, int value)
+			throws Exception
+	{
+		Field field = target.getClass().getDeclaredField(fieldName);
+		field.setAccessible(true);
+		field.setInt(target, value);
+	}
+
+	private static void setBoolean(
+			Object target,
+			String fieldName,
+			boolean value) throws Exception
+	{
+		Field field = target.getClass().getDeclaredField(fieldName);
+		field.setAccessible(true);
+		field.setBoolean(target, value);
+	}
+
+	private static void require(boolean condition, String message)
+	{
+		if (!condition)
+		{
+			throw new AssertionError(message);
+		}
+	}
+
+	private static final class Sample
+	{
+		private final String user;
+		private final String text;
+
+		private Sample(String user, String text)
+		{
+			this.user = user;
+			this.text = text;
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/Test/ReplayableCorpusStreamSelfTest.java b/TwitterGatherDataFollowers/Test/ReplayableCorpusStreamSelfTest.java
new file mode 100644
index 0000000..704036a
--- BEFORE/TwitterGatherDataFollowers/Test/ReplayableCorpusStreamSelfTest.java
+++ AFTER/TwitterGatherDataFollowers/Test/ReplayableCorpusStreamSelfTest.java
@@ -0,0 +1,102 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+
+public final class ReplayableCorpusStreamSelfTest
+{
+	private ReplayableCorpusStreamSelfTest()
+	{
+	}
+
+	public static void main(String[] args) throws Exception
+	{
+		preservesRowsRoutesAndReplay();
+		System.out.println("ReplayableCorpusStreamSelfTest passed");
+	}
+
+	private static void preservesRowsRoutesAndReplay() throws Exception
+	{
+		ArrayList<Tweet> tweets = new ArrayList<Tweet>();
+		tweets.add(new Tweet("alice target", 1L, new Date(1L), "alice"));
+		tweets.add(new Tweet("bob first", 2L, new Date(2L), "bob"));
+		tweets.add(new Tweet("bob second", 3L, new Date(3L), "bob"));
+		tweets.add(new Tweet("carol replicated", 4L, new Date(4L), "carol"));
+
+		Map<String,CorpusStreamRoute> routes =
+				new LinkedHashMap<String,CorpusStreamRoute>();
+		routes.put("alice", new CorpusStreamRoute(Arrays.asList(1, 2), 1));
+		routes.put("bob", new CorpusStreamRoute(Arrays.asList(1), 1));
+		routes.put("carol", new CorpusStreamRoute(Arrays.asList(1, 2), 2));
+
+		Map<String,String> followees = new LinkedHashMap<String,String>();
+		followees.put("alice", "journal-a");
+		followees.put("bob", "journal-b");
+		followees.put("carol", "journal-c");
+
+		ReplayableCorpusStream stream = ReplayableCorpusStream.create(
+				tweets,
+				routes,
+				followees,
+				new LinkedHashSet<String>(Arrays.asList("alice")));
+		try
+		{
+			require(stream.size() == 3, "target rows were not excluded");
+			require(stream.getRouteSources().size() == 2,
+					"route-compatible rows were not grouped");
+			List<String> firstReplay = replay(stream);
+			List<String> secondReplay = replay(stream);
+			require(firstReplay.equals(secondReplay),
+					"corpus replay changed between simulation runs");
+			require(firstReplay.contains(
+					"2\tbob\t2\tjournal-b\tbob first"),
+					"bob's first row or per-user count changed");
+			require(firstReplay.contains(
+					"2\tbob\t3\tjournal-b\tbob second"),
+					"bob's second row or per-user count changed");
+			require(firstReplay.contains(
+					"1\tcarol\t4\tjournal-c\tcarol replicated"),
+					"replicated route row changed");
+			for (String row : firstReplay)
+			{
+				require(!row.contains("\talice\t"),
+						"selected target leaked into the virtual corpus");
+			}
+		}
+		finally
+		{
+			stream.close();
+		}
+	}
+
+	private static List<String> replay(ReplayableCorpusStream stream)
+			throws Exception
+	{
+		ArrayList<String> rows = new ArrayList<String>();
+		for (ReplayableCorpusStream.RouteSource source
+				: stream.getRouteSources())
+		{
+			try (ReplayableCorpusStream.Reader reader = source.openReader())
+			{
+				while (reader.hasRemaining())
+				{
+					rows.addAll(reader.readBatch(2));
+				}
+			}
+		}
+		return rows;
+	}
+
+	private static void require(boolean condition, String message)
+	{
+		if (!condition)
+		{
+			throw new AssertionError(message);
+		}
+	}
+}

