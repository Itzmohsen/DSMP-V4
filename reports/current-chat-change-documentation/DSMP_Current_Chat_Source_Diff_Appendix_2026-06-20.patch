+		private void drawTarget(Graphics2D g, int x, int y, int w, int h, String target)
+		{
+			g.setColor(SURFACE);
+			g.fillRoundRect(x, y, w, h, RADIUS, RADIUS);
+			g.setColor(QUIET_BORDER);
+			g.drawRoundRect(x, y, w, h, RADIUS, RADIUS);
