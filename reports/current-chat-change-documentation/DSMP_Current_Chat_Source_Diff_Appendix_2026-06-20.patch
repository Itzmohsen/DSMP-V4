@@ -0,0 +1,114 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.util.List;
+
+import org.neuroph.core.Connection;
+import org.neuroph.core.Layer;
+import org.neuroph.core.NeuralNetwork;
+import org.neuroph.core.Neuron;
+import org.neuroph.core.Weight;
+import org.neuroph.nnet.MultiLayerPerceptron;
+
+final class MlpModelAverager
+{
+	private MlpModelAverager()
+	{
+	}
+
+	static void averageLegacyCompatible(List<String> modelPaths, String outputPath)
+	{
+		if (modelPaths == null || modelPaths.isEmpty())
+		{
+			throw new IllegalArgumentException("At least one MLP model is required");
+		}
+
+		MultiLayerPerceptron averaged =
+				(MultiLayerPerceptron) NeuralNetwork.createFromFile(modelPaths.get(0));
+		int connectionCount = countInputConnections(averaged);
+		double[] originalFirstWeights = new double[connectionCount];
+		double[] weightSums = new double[connectionCount];
+		accumulateInputWeights(
+				averaged, weightSums, originalFirstWeights, true);
+
+		for (int i = 1; i < modelPaths.size(); i++)
+		{
+			MultiLayerPerceptron current =
+					(MultiLayerPerceptron) NeuralNetwork.createFromFile(modelPaths.get(i));
+			accumulateInputWeights(current, weightSums, null, false);
+			current = null;
+		}
+
+		applyLegacyCompatibleWeights(
+				averaged, weightSums, originalFirstWeights, modelPaths.size());
+		averaged.save(outputPath);
+	}
+
+	private static int countInputConnections(MultiLayerPerceptron network)
+	{
+		int count = 0;
+		List<Layer> layers = network.getLayers();
+		for (int layerIndex = 1; layerIndex < layers.size(); layerIndex++)
+		{
+			for (Neuron neuron : layers.get(layerIndex).getNeurons())
+			{
+				count += neuron.getInputConnections().size();
+			}
+		}
+		return count;
+	}
+
+	private static void accumulateInputWeights(
+			MultiLayerPerceptron network,
+			double[] sums,
+			double[] firstWeights,
+			boolean recordFirst)
+	{
+		int index = 0;
+		List<Layer> layers = network.getLayers();
+		for (int layerIndex = 1; layerIndex < layers.size(); layerIndex++)
+		{
+			for (Neuron neuron : layers.get(layerIndex).getNeurons())
+			{
+				for (Connection connection : neuron.getInputConnections())
+				{
+					double value = connection.getWeight().getValue();
+					sums[index] += value;
+					if (recordFirst)
+					{
+						firstWeights[index] = value;
+					}
+					index++;
+				}
+			}
+		}
+		if (index != sums.length)
+		{
+			throw new IllegalStateException("MLP models do not share the same topology");
+		}
+	}
+
+	private static void applyLegacyCompatibleWeights(
+			MultiLayerPerceptron network,
+			double[] sums,
+			double[] firstWeights,
+			int modelCount)
+	{
+		int index = 0;
+		List<Layer> layers = network.getLayers();
+		for (int layerIndex = 1; layerIndex < layers.size(); layerIndex++)
+		{
+			for (Neuron neuron : layers.get(layerIndex).getNeurons())
+			{
+				for (Connection connection : neuron.getInputConnections())
+				{
+					double trueAverage = sums[index] / modelCount;
+					double otherModelsSum = sums[index] - firstWeights[index];
+					double legacyFinalWeight =
+							(trueAverage + otherModelsSum) / modelCount;
+					connection.setWeight(new Weight(legacyFinalWeight));
+					index++;
+				}
+			}
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/userRyersonU/ModelWorkerProcessSupport.java b/TwitterGatherDataFollowers/userRyersonU/ModelWorkerProcessSupport.java
new file mode 100644
index 0000000..3210483
--- BEFORE/TwitterGatherDataFollowers/userRyersonU/ModelWorkerProcessSupport.java
+++ AFTER/TwitterGatherDataFollowers/userRyersonU/ModelWorkerProcessSupport.java
@@ -0,0 +1,123 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Runs model subprocesses with bounded diagnostics and a hard containment
+ * timeout. The output drain prevents a full pipe from deadlocking a worker.
+ */
+final class ModelWorkerProcessSupport
+{
+	private static final int MAX_OUTPUT_CHARS = 65536;
+
+	private ModelWorkerProcessSupport()
+	{
+	}
+
+	static Result run(List<String> command, long timeoutSeconds) throws Exception
+	{
+		ProcessBuilder builder = new ProcessBuilder(command);
+		builder.redirectErrorStream(true);
+		final Process process = builder.start();
+		final StringBuilder output = new StringBuilder();
+		Thread outputDrainer = new Thread(new Runnable()
+		{
+			public void run()
+			{
+				try (BufferedReader reader = new BufferedReader(
+						new InputStreamReader(process.getInputStream())))
+				{
+					String line;
+					while ((line = reader.readLine()) != null)
+					{
+						synchronized (output)
+						{
+							if (output.length() < MAX_OUTPUT_CHARS)
+							{
+								output.append(line).append('\n');
+							}
+						}
+					}
+				}
+				catch (Exception ignored)
+				{
+					// The process exit/forced exit is the authoritative result.
+				}
+			}
+		}, "model-worker-output");
+		outputDrainer.setDaemon(true);
+		outputDrainer.start();
+
+		boolean finished = process.waitFor(
+				Math.max(1L, timeoutSeconds), TimeUnit.SECONDS);
+		if (!finished)
+		{
+			process.destroy();
+			if (!process.waitFor(5L, TimeUnit.SECONDS))
+			{
+				process.destroyForcibly();
+				process.waitFor(5L, TimeUnit.SECONDS);
+			}
+		}
+		outputDrainer.join(5000L);
+		String captured;
+		synchronized (output)
+		{
+			captured = output.toString();
+		}
+		return new Result(
+				finished ? process.exitValue() : -1,
+				!finished,
+				captured);
+	}
+
+	static long configuredTimeoutSeconds()
+	{
+		String configured = System.getProperty(
+				"recommender.svm.worker.timeout.seconds");
+		if (configured != null)
+		{
+			try
+			{
+				return Math.max(60L, Long.parseLong(configured.trim()));
+			}
+			catch (NumberFormatException ignored)
+			{
+				// Use the safe default below.
+			}
+		}
+		return 6L * 60L * 60L;
+	}
+
+	static final class Result
+	{
+		private final int exitCode;
+		private final boolean timedOut;
+		private final String output;
+
+		private Result(int exitCode, boolean timedOut, String output)
+		{
+			this.exitCode = exitCode;
+			this.timedOut = timedOut;
+			this.output = output;
+		}
+
+		int getExitCode()
+		{
+			return exitCode;
+		}
+
+		boolean isTimedOut()
+		{
+			return timedOut;
+		}
+
+		String getOutput()
+		{
+			return output;
+		}
+	}
+}

