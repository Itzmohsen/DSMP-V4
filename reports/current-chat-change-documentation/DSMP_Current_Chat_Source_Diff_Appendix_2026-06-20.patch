+	private String formatParameterErrors(List<String> errors)
+	{
+		StringBuilder builder = new StringBuilder(
+				"<html><b>Fix these settings:</b><br>");
+		for (String error : errors)
+		{
+			builder.append("&bull; ").append(error).append("<br>");
