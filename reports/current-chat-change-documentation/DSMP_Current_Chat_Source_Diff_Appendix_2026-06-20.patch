+						g2.drawLine(left + 4, top + 2, left + 4, bottom);
+						g2.drawLine(left + 7, top + 7, right - 3, top + 7);
+						g2.drawLine(left + 7, top + 11, right - 5, top + 11);
+						break;
+					case SETTINGS:
