+            return new Date(millis);
+        }
+        List<String> patterns = Arrays.asList(
+                "M/d/yyyy H:mm",
+                "M/d/yyyy HH:mm",
+                "MM/dd/yyyy HH:mm",
+                "MM/dd/yyyy H:mm",
+                "M/d/yy H:mm",
+                "yyyy-MM-dd",
+                "yyyy-MM-dd HH:mm:ss",
+                "yyyy/MM/dd",
+                "dd/MM/yyyy HH:mm",
