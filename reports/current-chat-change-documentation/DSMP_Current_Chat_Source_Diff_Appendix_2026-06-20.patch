+    private static int columnIndexFromCellRef(String reference) {
+        if (reference == null || reference.length() == 0) {
+            return 0;
+        }
+        int col = 0;
+        for (int i = 0; i < reference.length(); i++) {
+            char c = reference.charAt(i);
+            if (c >= 'A' && c <= 'Z') {
+                col = col * 26 + (c - 'A' + 1);
+            } else if (c >= 'a' && c <= 'z') {
+                col = col * 26 + (c - 'a' + 1);
+            } else {
+                break;
+            }
+        }
+        return Math.max(0, col - 1);
+    }
