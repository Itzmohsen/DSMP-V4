+            if (trimmed.length() == 0 || parseDouble(trimmed) != null || parseFlexibleDate(trimmed) != null) {
+                dataish++;
+            }
+        }
+        return firstRow.size() > 1 && headerish >= Math.max(2, firstRow.size() / 2) && dataish >= Math.max(1, secondRow.size() / 3);
+    }
