+		writer.write(title);
+		writer.newLine();
+		if (lines == null || lines.isEmpty())
+		{
+			writer.write("- None");
+			writer.newLine();
+			return;
+		}
+		for (String line : lines)
+		{
+			writer.write("- " + line);
+			writer.newLine();
+		}
+	}
+
+	private static void writeNodeSection(
