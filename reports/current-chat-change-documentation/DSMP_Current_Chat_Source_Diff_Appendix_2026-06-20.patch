@@ -0,0 +1,70 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * In-process cancellation signal shared by recommender agents in the same JADE
+ * container. It prevents queued model workers and late score publications after
+ * one required node has failed.
+ */
+final class RecommendationRunAbortRegistry
+{
+	private static final Object LOCK = new Object();
+	private static final Map<String,String> ABORTED_RUNS =
+			new HashMap<String,String>();
+
+	private RecommendationRunAbortRegistry()
+	{
+	}
+
+	static void prepare(String runId)
+	{
+		if (runId == null)
+		{
+			return;
+		}
+		synchronized (LOCK)
+		{
+			ABORTED_RUNS.remove(runId);
+		}
+	}
+
+	static void abort(String runId, String reason)
+	{
+		if (runId == null)
+		{
+			return;
+		}
+		synchronized (LOCK)
+		{
+			if (!ABORTED_RUNS.containsKey(runId))
+			{
+				ABORTED_RUNS.put(
+						runId,
+						reason == null ? "Recommendation run aborted." : reason);
+			}
+		}
+	}
+
+	static boolean isAborted(String runId)
+	{
+		synchronized (LOCK)
+		{
+			return runId != null && ABORTED_RUNS.containsKey(runId);
+		}
+	}
+
+	static void requireActive(String runId)
+	{
+		synchronized (LOCK)
+		{
+			String reason = runId == null ? null : ABORTED_RUNS.get(runId);
+			if (reason != null)
+			{
+				throw new IllegalStateException(
+						"Recommendation run was already aborted: " + reason);
+			}
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/userRyersonU/RecommendationRunLifecycle.java b/TwitterGatherDataFollowers/userRyersonU/RecommendationRunLifecycle.java
new file mode 100644
index 0000000..87db599
--- BEFORE/TwitterGatherDataFollowers/userRyersonU/RecommendationRunLifecycle.java
+++ AFTER/TwitterGatherDataFollowers/userRyersonU/RecommendationRunLifecycle.java
@@ -0,0 +1,117 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.util.Iterator;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.UUID;
+
+final class RecommendationRunLifecycle
+{
+	enum Admission
+	{
+		NEW_RUN,
+		CURRENT_RUN,
+		RETIRED_RUN
+	}
+
+	private static final String LEGACY_RUN_ID = "StartSim-legacy";
+	private static final int MAX_RETIRED_RUNS = 16;
+
+	private final Set<String> retiredRunIds = new LinkedHashSet<String>();
+	private String activeRunId;
+	private boolean inputDeliveryComplete;
+	private boolean textProcessingComplete;
+
+	static String createRunId()
+	{
+		return "StartSim-" + UUID.randomUUID().toString();
+	}
+
+	Admission admit(String requestedRunId)
+	{
+		String runId = normalize(requestedRunId);
+		if (activeRunId == null)
+		{
+			activeRunId = runId;
+			inputDeliveryComplete = false;
+			textProcessingComplete = false;
+			return Admission.NEW_RUN;
+		}
+		if (activeRunId.equals(runId))
+		{
+			return Admission.CURRENT_RUN;
+		}
+		if (retiredRunIds.contains(runId))
+		{
+			return Admission.RETIRED_RUN;
+		}
+
+		retire(activeRunId);
+		activeRunId = runId;
+		inputDeliveryComplete = false;
+		textProcessingComplete = false;
+		return Admission.NEW_RUN;
+	}
+
+	boolean isActive(String requestedRunId)
+	{
+		return activeRunId != null && activeRunId.equals(normalize(requestedRunId));
+	}
+
+	String getActiveRunId()
+	{
+		return activeRunId;
+	}
+
+	boolean isTextProcessingComplete()
+	{
+		return textProcessingComplete;
+	}
+
+	boolean markInputDeliveryComplete(String requestedRunId)
+	{
+		if (!isActive(requestedRunId) || inputDeliveryComplete)
+		{
+			return false;
+		}
+		inputDeliveryComplete = true;
+		return true;
+	}
+
+	boolean isInputDeliveryComplete()
+	{
+		return inputDeliveryComplete;
+	}
+
+	boolean markTextProcessingCompleteIfReady(int receivedTweets, int expectedTweets)
+	{
+		if (textProcessingComplete || !inputDeliveryComplete
+				|| receivedTweets < expectedTweets)
+		{
+			return false;
+		}
+		textProcessingComplete = true;
+		return true;
+	}
+
+	private void retire(String runId)
+	{
+		retiredRunIds.add(runId);
+		while (retiredRunIds.size() > MAX_RETIRED_RUNS)
+		{
+			Iterator<String> iterator = retiredRunIds.iterator();
+			if (!iterator.hasNext())
+			{
+				return;
+			}
+			iterator.next();
+			iterator.remove();
+		}
+	}
+
+	private static String normalize(String runId)
+	{
+		return runId == null || runId.trim().length() == 0
+				? LEGACY_RUN_ID : runId;
+	}
+}

