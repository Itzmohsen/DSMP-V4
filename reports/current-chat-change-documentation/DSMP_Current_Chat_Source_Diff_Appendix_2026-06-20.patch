+						g2.fillOval(right - 6, top + 1, 5, 5);
+						g2.fillOval(right - 5, bottom - 6, 5, 5);
+						g2.drawLine(left + 6, top + 7, right - 6, top + 4);
+						g2.drawLine(left + 6, top + 9, right - 5, bottom - 4);
