+		}
+
+		List<NodeSnapshot> getNodes()
+		{
+			return nodes;
+		}
+
+		int count(State state)
+		{
+			int count = 0;
+			for (NodeSnapshot node : nodes)
+			{
+				if (node.state == state)
+				{
+					count++;
+				}
+			}
+			return count;
+		}
+
+		int activeCount()
+		{
+			int count = 0;
+			for (NodeSnapshot node : nodes)
