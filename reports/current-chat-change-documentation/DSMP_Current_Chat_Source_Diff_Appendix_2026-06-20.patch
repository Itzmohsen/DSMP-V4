+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.io.File;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+public final class GraphAnalysisEngineSelfTest
+{
+	private GraphAnalysisEngineSelfTest()
+	{
+	}
+
+	public static void main(String[] args) throws Exception
+	{
+		analyzesCurrentTwoEdgeRecommendationFormat();
+		flagsMalformedAndUnknownEdgesWithoutFailing();
+		handlesMissingEdgeFileAsWaitingState();
+		derivesModeSpecificEdgeFileNames();
+		System.out.println("GraphAnalysisEngineSelfTest passed");
+	}
+
+	private static void analyzesCurrentTwoEdgeRecommendationFormat() throws Exception
+	{
+		Path directory = Files.createTempDirectory("graph-analysis");
+		File mapping = write(directory, "name-number-sample.txt",
+				"StoreA\t1\nAlice\t2\nStoreB\t3\nBob\t4\nStoreC\t5\nCarol\t6\n");
+		File edges = write(directory, "edges-numbers-sample.txt",
+				"2 1\n2 5\n4 3\n4 5\n6 3\n6 5\n");
+
+		GraphAnalysisEngine.Analysis analysis =
+				GraphAnalysisEngine.analyze(mapping, edges);
+
+		require(analysis.available, "analysis should be available");
+		require(analysis.mappedNodeCount == 6, "unexpected mapped count");
+		require(analysis.activeNodeCount == 6, "unexpected active count");
+		require(analysis.validEdgeCount == 6L, "unexpected edge count");
+		require(analysis.recommendationEdgeCount == 3L, "unexpected recommendation edge count");
+		require(analysis.uniqueRecommendedTargets == 1, "unexpected recommendation diversity");
+		require(!analysis.topRecommendedTargets.isEmpty(), "missing top recommended target");
+		require("StoreC".equals(analysis.topRecommendedTargets.get(0).name),
+				"top recommended target was not StoreC");
+		require(analysis.topRecommendedTargets.get(0).value == 3,
+				"StoreC should have three recommendation edges");
+		require(analysis.recommendationChangedTargetCount == 3L,
+				"all recommendations should differ from original labels");
+		require(analysis.activeComponentCount == 1,
+				"this small graph should be one active component");
+		require(analysis.warnings.toString().contains("fewer than 10 valid edges"),
+				"small graph warning was not emitted");
+	}
+
+	private static void flagsMalformedAndUnknownEdgesWithoutFailing() throws Exception
+	{
+		Path directory = Files.createTempDirectory("graph-analysis-invalid");
+		File mapping = write(directory, "name-number-sample.txt",
+				"Known\t1\nTarget\t2\n");
+		File edges = write(directory, "edges-numbers-sample.txt",
+				"1 2\nbad line\n1 99\n2 1\n");
+
+		GraphAnalysisEngine.Analysis analysis =
+				GraphAnalysisEngine.analyze(mapping, edges);
+
+		require(analysis.validEdgeCount == 2L, "valid edges were not retained");
+		require(analysis.malformedEdgeLines == 1L, "malformed edge was not counted");
+		require(analysis.unknownNodeEdges == 1L, "unknown node edge was not counted");
+		require("NEEDS ATTENTION".equals(analysis.statusLabel()),
+				"invalid graph should need attention");
+	}
+
+	private static void handlesMissingEdgeFileAsWaitingState() throws Exception
+	{
+		Path directory = Files.createTempDirectory("graph-analysis-missing");
+		File mapping = write(directory, "name-number-sample.txt",
+				"Known\t1\nTarget\t2\n");
+		File edges = directory.resolve("edges-numbers-sample.txt").toFile();
+
+		GraphAnalysisEngine.Analysis analysis =
+				GraphAnalysisEngine.analyze(mapping, edges);
+
+		require(analysis.available, "mapping alone should still produce an analysis");
+		require(analysis.validEdgeCount == 0L, "missing edge file should have zero edges");
+		require("NO EDGES YET".equals(analysis.statusLabel()),
+				"missing edge file should be a no-edges state");
+		require(analysis.warnings.toString().contains("No edge list exists yet"),
+				"missing edge warning was not emitted");
+	}
+
+	private static void derivesModeSpecificEdgeFileNames()
+	{
+		String regular = GraphAnalysisEngine.graphEdgesBaseName("Retail 50K.txt", "");
+		require("edges-numbers-Retail_50K".equals(regular),
+				"regular edge base name was wrong: " + regular);
+
+		String converted = GraphAnalysisEngine.graphEdgesBaseName(
+				"Retail 50K.txt",
+				GraphAnalysisEngine.convertedModeSuffix(
+						RecommendationTargetMode.SIMILAR_USERS,
+						RecommendationModeSupport.SVM));
+		require("edges-numbers-Retail_50K_similar-users".equals(converted),
+				"converted edge base name was wrong: " + converted);
+	}
+
+	private static File write(Path directory, String fileName, String content) throws Exception
+	{
+		Path file = directory.resolve(fileName);
+		Files.write(file, content.getBytes(StandardCharsets.UTF_8));
+		return file.toFile();
+	}
+
+	private static void require(boolean condition, String message)
+	{
+		if (!condition)
+		{
+			throw new AssertionError(message);
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/Test/GraphGenerationSettingSelfTest.java b/TwitterGatherDataFollowers/Test/GraphGenerationSettingSelfTest.java
new file mode 100644
index 0000000..06c53a2
--- BEFORE/TwitterGatherDataFollowers/Test/GraphGenerationSettingSelfTest.java
+++ AFTER/TwitterGatherDataFollowers/Test/GraphGenerationSettingSelfTest.java
@@ -0,0 +1,129 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.Arrays;
+
+public final class GraphGenerationSettingSelfTest
+{
+	private GraphGenerationSettingSelfTest()
+	{
+	}
+
+	public static void main(String[] args) throws Exception
+	{
+		RecommendationExperimentConfig legacyConfig =
+				RecommendationExperimentConfig.legacyDefault(
+						RecommendationModeSupport.SVM,
+						ControllerAgent.FROM_TEXT);
+		assertTrue(legacyConfig.isGraphGenerationEnabled(),
+				"Legacy experiments must continue generating graphs");
+
+		RecommendationExperimentConfig checkedConfig =
+				new RecommendationExperimentConfig(
+						RecommendationTargetMode.SIMILAR_USERS,
+						RecommendationModeSupport.DOC2VEC,
+						ControllerAgent.FROM_TEXT,
+						Arrays.asList("alice", "bob"),
+						true);
+		assertTrue(checkedConfig.isGraphGenerationEnabled(),
+				"Checked graph setting was not preserved");
+
+		RecommendationExperimentConfig uncheckedConfig =
+				new RecommendationExperimentConfig(
+						RecommendationTargetMode.FOLLOWEE_ACCOUNTS,
+						RecommendationModeSupport.SVM,
+						ControllerAgent.FROM_TEXT,
+						Arrays.asList("alice"),
+						false);
+		assertTrue(!uncheckedConfig.isGraphGenerationEnabled(),
+				"Unchecked graph setting was not preserved");
+
+		RecommendationExperimentConfig serializedConfig = roundTrip(uncheckedConfig);
+		assertTrue(!serializedConfig.isGraphGenerationEnabled(),
+				"Unchecked graph setting did not survive agent serialization");
+
+		File datasetFile = File.createTempFile("experiment-dataset-snapshot", ".txt");
+		Files.write(datasetFile.toPath(), "dataset".getBytes(StandardCharsets.UTF_8));
+		RecommendationExperimentConfig datasetConfig =
+				new RecommendationExperimentConfig(
+						RecommendationTargetMode.SIMILAR_USERS,
+						RecommendationModeSupport.DOC2VEC,
+						ControllerAgent.FROM_TEXT,
+						Arrays.asList("alice"),
+						false,
+						datasetFile);
+		RecommendationExperimentConfig serializedDatasetConfig =
+				roundTrip(datasetConfig);
+		assertTrue(datasetFile.getAbsoluteFile().equals(
+						serializedDatasetConfig.getDatasetFile()),
+				"Dataset snapshot path did not survive agent serialization");
+		assertTrue(serializedDatasetConfig.validateDatasetSnapshot() == null,
+				"Unchanged dataset snapshot was rejected");
+		Files.write(datasetFile.toPath(), "changed dataset".getBytes(StandardCharsets.UTF_8));
+		assertTrue(serializedDatasetConfig.validateDatasetSnapshot() != null,
+				"Changed dataset snapshot was not detected");
+		datasetFile.delete();
+
+		RecommendationExperimentConfig convertedUserConfig =
+				new RecommendationExperimentConfig(
+						RecommendationTargetMode.SIMILAR_USERS,
+						RecommendationModeSupport.SVM,
+						ControllerAgent.FROM_TEXT,
+						Arrays.asList("alice"),
+						true);
+		assertTrue("_similar-users".equals(convertedUserConfig.getConvertedModeFileSuffix()),
+				"Converted user graph suffix is inconsistent");
+
+		RecommendationExperimentConfig convertedFolloweeConfig =
+				new RecommendationExperimentConfig(
+						RecommendationTargetMode.FOLLOWEE_ACCOUNTS,
+						RecommendationModeSupport.DOC2VEC,
+						ControllerAgent.FROM_TEXT,
+						Arrays.asList("alice"),
+						true);
+		assertTrue("_followee-accounts".equals(convertedFolloweeConfig.getConvertedModeFileSuffix()),
+				"Converted followee graph suffix is inconsistent");
+
+		Object[] runArgs = new Object[14];
+		runArgs[13] = Boolean.FALSE;
+		assertTrue(!StarterAgent.resolveGraphGenerationEnabled(runArgs, checkedConfig),
+				"Run-time unchecked graph setting did not override initialization");
+		runArgs[13] = Boolean.TRUE;
+		assertTrue(StarterAgent.resolveGraphGenerationEnabled(runArgs, uncheckedConfig),
+				"Run-time checked graph setting did not override initialization");
+		assertTrue(!StarterAgent.resolveGraphGenerationEnabled(new Object[13], uncheckedConfig),
+				"Legacy run did not retain its initialization graph setting");
+
+		System.out.println("Graph generation setting self-test passed");
+	}
+
+	private static RecommendationExperimentConfig roundTrip(
+			RecommendationExperimentConfig config) throws Exception
+	{
+		ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+		ObjectOutputStream output = new ObjectOutputStream(bytes);
+		output.writeObject(config);
+		output.close();
+
+		ObjectInputStream input = new ObjectInputStream(
+				new ByteArrayInputStream(bytes.toByteArray()));
+		RecommendationExperimentConfig copy =
+				(RecommendationExperimentConfig) input.readObject();
+		input.close();
+		return copy;
+	}
+
+	private static void assertTrue(boolean condition, String message)
+	{
+		if (!condition)
+		{
+			throw new AssertionError(message);
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/Test/HeavyParallelDatasetTool.java b/TwitterGatherDataFollowers/Test/HeavyParallelDatasetTool.java
