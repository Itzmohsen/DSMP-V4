+		{
+			this.requestedNodes = requestedNodes;
+			this.runSequence = runSequence;
+			this.algorithmName = algorithmName;
+			this.runId = runId;
+			this.runPhase = runPhase;
+			this.experimentStartedAt = experimentStartedAt;
