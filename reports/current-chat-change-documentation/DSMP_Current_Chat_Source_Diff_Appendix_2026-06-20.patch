+
+			private static Color statusColor(StatusTone tone)
+			{
+				switch (tone)
+				{
+					case RUNNING:
+						return APP_BLUE;
+					case SUCCESS:
+						return APP_GREEN;
+					case WARNING:
+						return new Color(207, 125, 31);
+					case ERROR:
+						return APP_RED;
+					case READY:
+					default:
+						return new Color(82, 105, 130);
+				}
+			}
