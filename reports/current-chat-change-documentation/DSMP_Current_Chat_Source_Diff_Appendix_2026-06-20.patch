+
+final class Doc2VecCacheAdmin
+{
+	private static final String INFO_PREFIX = "CACHE_INFO";
+
+	private Doc2VecCacheAdmin()
+	{
+	}
+
+	static CacheInfo inspect(
+			String pythonCommand,
+			File datasetFile,
+			int workers) throws IOException, InterruptedException
