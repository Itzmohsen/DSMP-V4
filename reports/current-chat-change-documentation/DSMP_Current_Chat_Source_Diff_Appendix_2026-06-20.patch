@@ -0,0 +1,79 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+public final class LargeTextAgentProvisioningSelfTest
+{
+	private LargeTextAgentProvisioningSelfTest()
+	{
+	}
+
+	public static void main(String[] args)
+	{
+		preservesDirectProvisioningForOrdinaryDatasets();
+		boundsLargeDatasetParticipants();
+		System.out.println("LargeTextAgentProvisioningSelfTest passed");
+	}
+
+	private static void preservesDirectProvisioningForOrdinaryDatasets()
+	{
+		require(!ControllerAgent.shouldUseBoundedTextAgentProvisioning(512),
+				"ordinary text datasets unexpectedly use virtual provisioning");
+		require(ControllerAgent.calculateTextParticipantCount(
+				users(40), Arrays.asList("user-1"), false) == 40,
+				"ordinary text participant count changed");
+	}
+
+	private static void boundsLargeDatasetParticipants()
+	{
+		List<String> activeUsers = users(38546);
+		require(ControllerAgent.supportsBoundedCorpusStreaming(
+				ControllerAgent.SVM),
+				"SVM large-corpus streaming is not enabled");
+		require(ControllerAgent.supportsBoundedCorpusStreaming(
+				ControllerAgent.SCALABLE_SVM),
+				"Scalable SVM large-corpus streaming is not enabled");
+		require(ControllerAgent.supportsBoundedCorpusStreaming(
+				ControllerAgent.Doc2Vec),
+				"Doc2Vec large-corpus streaming is not enabled");
+		require(!ControllerAgent.supportsBoundedCorpusStreaming(
+				ControllerAgent.K_MEANS),
+				"unvalidated algorithms must retain their existing agent path");
+		require(ControllerAgent.shouldUseBoundedTextAgentProvisioning(
+				activeUsers.size()),
+				"38k journal dataset did not enable bounded provisioning");
+		require(ControllerAgent.calculateTextParticipantCount(
+				activeUsers, Arrays.asList("user-1"), true) == 2,
+				"one target plus one corpus streamer was not provisioned");
+		require(ControllerAgent.calculateTextParticipantCount(
+				activeUsers,
+				Arrays.asList("user-1", "user-2", "user-2", "missing"),
+				true) == 3,
+				"active targets were not counted uniquely");
+		require(ControllerAgent.calculateTextParticipantCount(
+				Arrays.asList("user-1", "user-2"),
+				Arrays.asList("user-1", "user-2"),
+				true) == 2,
+				"a phantom corpus streamer was counted when every user is a target");
+	}
+
+	private static List<String> users(int count)
+	{
+		ArrayList<String> users = new ArrayList<String>(count);
+		for (int i = 1; i <= count; i++)
+		{
+			users.add("user-" + i);
+		}
+		return users;
+	}
+
+	private static void require(boolean condition, String message)
+	{
+		if (!condition)
+		{
+			throw new AssertionError(message);
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/Test/MillionRowIngestionSelfTest.java b/TwitterGatherDataFollowers/Test/MillionRowIngestionSelfTest.java
new file mode 100644
index 0000000..79968ae
--- BEFORE/TwitterGatherDataFollowers/Test/MillionRowIngestionSelfTest.java
+++ AFTER/TwitterGatherDataFollowers/Test/MillionRowIngestionSelfTest.java
@@ -0,0 +1,136 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+public final class MillionRowIngestionSelfTest
+{
+	private MillionRowIngestionSelfTest()
+	{
+	}
+
+	public static void main(String[] args) throws Exception
+	{
+		if (args.length != 1)
+		{
+			throw new IllegalArgumentException("Expected the generated dataset path");
+		}
+		File dataset = new File(args[0]);
+		InMemoryDb local = new InMemoryDb();
+		Map<String,Integer> expectedCounts = new LinkedHashMap<String,Integer>();
+		long rows = 0L;
+
+		try (BufferedReader reader = new BufferedReader(
+				new InputStreamReader(
+						new FileInputStream(dataset), StandardCharsets.UTF_8),
+				128 * 1024))
+		{
+			String line;
+			while ((line = reader.readLine()) != null)
+			{
+				DatasetRow row = DatasetRow.parse(line, rows + 1L);
+				local.addTweet(new Tweet(
+						row.text, row.tweetId, row.tweetDate, row.userName));
+				Integer count = expectedCounts.get(row.userName);
+				expectedCounts.put(
+						row.userName,
+						Integer.valueOf(count == null ? 1 : count.intValue() + 1));
+				rows++;
+			}
+		}
+
+		require(rows == 1000000L, "stress corpus does not contain one million rows");
+		require(local.getTotalTweets() == 1000000,
+				"local database lost rows during ingestion");
+
+		Collections.sort(local.getTweets());
+		local.refreshUserIndex();
+		ArrayList<Tweet> availableTweets =
+				new ArrayList<Tweet>(local.getTweets());
+		InMemoryDb available = new InMemoryDb();
+		available.setTweets(availableTweets);
+
+		ArrayList<ArrayList<Tweet>> mobileAgentSources =
+				new ArrayList<ArrayList<Tweet>>(expectedCounts.size());
+		long assignedRows = 0L;
+		for (Map.Entry<String,Integer> entry : expectedCounts.entrySet())
+		{
+			require(available.getTweetCountFromUser(entry.getKey())
+							== entry.getValue().intValue(),
+					"indexed count mismatch for " + entry.getKey());
+			ArrayList<Tweet> userTweets =
+					available.getTweetsFromUser(entry.getKey());
+			assignedRows += userTweets.size();
+			mobileAgentSources.add(userTweets);
+		}
+		require(assignedRows == rows,
+				"mobile-agent assignment did not preserve every row");
+
+		local.clearDb();
+		available.clearDb();
+		availableTweets.clear();
+		require(sumSizes(mobileAgentSources) == rows,
+				"controller cleanup invalidated mobile-agent source lists");
+
+		ArrayList<ReplayableTweetBatchSource> replaySources =
+				new ArrayList<ReplayableTweetBatchSource>();
+		long replayRows = 0L;
+		try
+		{
+			for (ArrayList<Tweet> userTweets : mobileAgentSources)
+			{
+				ReplayableTweetBatchSource source =
+						ReplayableTweetBatchSource.create(
+								userTweets, userTweets.size(), "followee");
+				replaySources.add(source);
+				replayRows += source.size();
+				userTweets.clear();
+			}
+			require(replayRows == rows,
+					"disk-backed mobile sources did not preserve every row");
+
+			System.gc();
+			Thread.sleep(100L);
+			Runtime runtime = Runtime.getRuntime();
+			long usedMb = (runtime.totalMemory() - runtime.freeMemory())
+					/ (1024L * 1024L);
+			System.out.println(
+					"MillionRowIngestionSelfTest passed: rows=" + rows
+					+ " users=" + expectedCounts.size()
+					+ " replayRows=" + replayRows
+					+ " usedHeapAfterSpoolMB=" + usedMb);
+		}
+		finally
+		{
+			for (ReplayableTweetBatchSource source : replaySources)
+			{
+				source.close();
+			}
+		}
+	}
+
+	private static long sumSizes(ArrayList<ArrayList<Tweet>> lists)
+	{
+		long total = 0L;
+		for (ArrayList<Tweet> list : lists)
+		{
+			total += list.size();
+		}
+		return total;
+	}
+
+	private static void require(boolean condition, String message)
+	{
+		if (!condition)
+		{
+			throw new AssertionError(message);
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/Test/MillionRowSparseSvmSelfTest.java b/TwitterGatherDataFollowers/Test/MillionRowSparseSvmSelfTest.java
new file mode 100644
index 0000000..e4d6060
--- BEFORE/TwitterGatherDataFollowers/Test/MillionRowSparseSvmSelfTest.java
+++ AFTER/TwitterGatherDataFollowers/Test/MillionRowSparseSvmSelfTest.java
@@ -0,0 +1,313 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileReader;
+import java.io.FileWriter;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeSet;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import weka.classifiers.functions.SMO;
+import weka.core.Instances;
+
+public final class MillionRowSparseSvmSelfTest
+{
+	private MillionRowSparseSvmSelfTest()
+	{
+	}
+
+	public static void main(String[] args) throws Exception
+	{
+		if (args.length < 1 || args.length > 2)
+		{
+			throw new IllegalArgumentException(
+					"Expected the generated dataset path and optional worker count");
+		}
+		int requestedWorkers = args.length == 2
+				? Math.max(1, Integer.parseInt(args[1])) : 1;
+
+		Map<String,LinkedHashMap<String,Double>> documents =
+				new LinkedHashMap<String,LinkedHashMap<String,Double>>();
+		Map<String,String> userClasses = new LinkedHashMap<String,String>();
+		TreeSet<String> terms = new TreeSet<String>();
+		TreeSet<String> classes = new TreeSet<String>();
+		long rows = 0L;
+
+		try (BufferedReader reader = new BufferedReader(
+				new InputStreamReader(
+						new FileInputStream(args[0]), StandardCharsets.UTF_8),
+				128 * 1024))
+		{
+			String line;
+			while ((line = reader.readLine()) != null)
+			{
+				DatasetRow row = DatasetRow.parse(line, rows + 1L);
+				LinkedHashMap<String,Double> document =
+						documents.get(row.userName);
+				if (document == null)
+				{
+					document = new LinkedHashMap<String,Double>();
+					documents.put(row.userName, document);
+					userClasses.put(row.userName, row.referenceUser);
+				}
+				classes.add(row.referenceUser);
+				for (String token : row.text.toLowerCase().split("[^a-z]+"))
+				{
+					if (token.length() == 0)
+						continue;
+					terms.add(token);
+					Double frequency = document.get(token);
+					document.put(token, frequency == null ? 1.0 : frequency + 1.0);
+				}
+				rows++;
+			}
+		}
+
+		require(rows == 1000000L, "stress corpus does not contain one million rows");
+		require(terms.size() >= 70000,
+				"stress corpus did not reproduce a 70k-plus feature space");
+		require(classes.size() >= 2, "stress corpus needs multiple SVM classes");
+
+		Map<String,Integer> documentFrequency =
+				new LinkedHashMap<String,Integer>();
+		for (Map<String,Double> document : documents.values())
+		{
+			for (String term : document.keySet())
+			{
+				Integer frequency = documentFrequency.get(term);
+				documentFrequency.put(
+						term,
+						Integer.valueOf(frequency == null ? 1 : frequency.intValue() + 1));
+			}
+		}
+
+		int documentCount = documents.size();
+		for (Map.Entry<String,LinkedHashMap<String,Double>> entry
+				: documents.entrySet())
+		{
+			LinkedHashMap<String,Double> raw = entry.getValue();
+			LinkedHashMap<String,Double> normalized =
+					new LinkedHashMap<String,Double>();
+			double magnitude = 0.0;
+			for (Map.Entry<String,Double> termEntry : raw.entrySet())
+			{
+				int df = documentFrequency.get(termEntry.getKey()).intValue();
+				double idf = Math.log10(documentCount / df) / Math.log10(2);
+				double tfidf = termEntry.getValue().doubleValue() * idf;
+				normalized.put(termEntry.getKey(), Double.valueOf(tfidf));
+				magnitude += tfidf * tfidf;
+			}
+			magnitude = Math.sqrt(magnitude);
+			for (Map.Entry<String,Double> termEntry : normalized.entrySet())
+			{
+				termEntry.setValue(Double.valueOf(
+						termEntry.getValue().doubleValue() / magnitude));
+			}
+			entry.setValue(normalized);
+		}
+
+		File arff = File.createTempFile("million-row-sparse-svm-", ".arff");
+		try
+		{
+			ArrayList<String> orderedTerms = new ArrayList<String>(terms);
+			try (BufferedWriter writer = new BufferedWriter(new FileWriter(arff)))
+			{
+				SparseArffWriter.writeHeader(
+						writer,
+						"millionRowSparseSvm",
+						orderedTerms,
+						new ArrayList<String>(classes));
+				for (Map.Entry<String,LinkedHashMap<String,Double>> entry
+						: documents.entrySet())
+				{
+					SparseArffWriter.writeRow(
+							writer,
+							entry.getValue(),
+							orderedTerms,
+							userClasses.get(entry.getKey()));
+				}
+			}
+
+			long reservation =
+					RecommendationMemoryCoordinator.estimateSvmBytes(
+							terms.size(), documents.size(), arff);
+			int workerCount = Math.min(
+					requestedWorkers,
+					RecommendationMemoryCoordinator.recommendedParallelism(
+							RecommendationMemoryCoordinator.Workload.SVM,
+							reservation));
+
+			long sequentialStart = System.nanoTime();
+			List<double[]> sequentialScores = new ArrayList<double[]>();
+			for (int worker = 0; worker < workerCount; worker++)
+			{
+				sequentialScores.add(trainModel(arff));
+			}
+			long sequentialMs =
+					(System.nanoTime() - sequentialStart) / 1000000L;
+
+			System.gc();
+			Thread.sleep(100L);
+
+			AtomicInteger active = new AtomicInteger();
+			AtomicInteger maxActive = new AtomicInteger();
+			CountDownLatch start = new CountDownLatch(1);
+			List<double[]> parallelScores =
+					Collections.synchronizedList(new ArrayList<double[]>());
+			List<Throwable> failures =
+					Collections.synchronizedList(new ArrayList<Throwable>());
+			List<Thread> workers = new ArrayList<Thread>();
+			long parallelStart = System.nanoTime();
+			for (int worker = 0; worker < workerCount; worker++)
+			{
+				final int workerNumber = worker;
+				Thread thread = new Thread(new Runnable()
+				{
+					public void run()
+					{
+						await(start);
+						try (RecommendationMemoryCoordinator.Lease ignored =
+								RecommendationMemoryCoordinator.acquire(
+										"wide-svm-worker-"+workerNumber,
+										"million-row sparse SVM",
+										RecommendationMemoryCoordinator.Workload.SVM,
+										reservation))
+						{
+							int nowActive = active.incrementAndGet();
+							updateMaximum(maxActive, nowActive);
+							try
+							{
+								parallelScores.add(trainModel(arff));
+							}
+							finally
+							{
+								active.decrementAndGet();
+							}
+						}
+						catch (Throwable failure)
+						{
+							failures.add(failure);
+						}
+					}
+				});
+				workers.add(thread);
+				thread.start();
+			}
+			start.countDown();
+			for (Thread worker : workers)
+			{
+				worker.join(120000L);
+				require(!worker.isAlive(), "parallel wide SVM worker timed out");
+			}
+			long parallelMs = (System.nanoTime() - parallelStart) / 1000000L;
+
+			require(failures.isEmpty(),
+					"parallel wide SVM failed: "+failures);
+			require(parallelScores.size() == workerCount,
+					"parallel wide SVM lost model results");
+			if (workerCount > 1)
+			{
+				require(maxActive.get() > 1,
+						"wide SVM models were still serialized");
+			}
+			for (double[] score : sequentialScores)
+			{
+				require(Arrays.equals(sequentialScores.get(0), score),
+						"sequential wide SVM models changed scores");
+			}
+			for (double[] score : parallelScores)
+			{
+				require(Arrays.equals(sequentialScores.get(0), score),
+						"parallel scheduling changed SVM scores");
+			}
+
+			Runtime runtime = Runtime.getRuntime();
+			long usedMb = (runtime.totalMemory() - runtime.freeMemory())
+					/ (1024L * 1024L);
+			System.out.println(
+					"MillionRowSparseSvmSelfTest passed: rows=" + rows
+					+ " users=" + documents.size()
+					+ " terms=" + terms.size()
+					+ " classes=" + classes.size()
+					+ " workers=" + workerCount
+					+ " maxConcurrent=" + maxActive.get()
+					+ " sequentialMs=" + sequentialMs
+					+ " parallelMs=" + parallelMs
+					+ " speedup="
+					+ String.format("%.2fx", sequentialMs / (double)Math.max(1L, parallelMs))
+					+ " usedHeapMB=" + usedMb);
+		}
+		finally
+		{
+			arff.delete();
+		}
+	}
+
+	private static double[] trainModel(File arff) throws Exception
+	{
+		Instances instances;
+		try (FileReader reader = new FileReader(arff))
+		{
+			instances = new Instances(reader);
+		}
+		instances.setClassIndex(instances.numAttributes() - 1);
+		SMO model = new SMO();
+		model.setC(0.1);
+		model.setBuildCalibrationModels(true);
+		SvmReproducibility.applyModelSeed(model);
+		model.buildClassifier(instances);
+		return model.distributionForInstance(instances.instance(0));
+	}
+
+	private static void await(CountDownLatch latch)
+	{
+		boolean interrupted = false;
+		while (true)
+		{
+			try
+			{
+				latch.await();
+				break;
+			}
+			catch (InterruptedException e)
+			{
+				interrupted = true;
+			}
+		}
+		if (interrupted)
+		{
+			Thread.currentThread().interrupt();
+		}
+	}
+
+	private static void updateMaximum(AtomicInteger maximum, int value)
+	{
+		int current;
+		do
+		{
+			current = maximum.get();
+			if (value <= current)
+				return;
+		}
+		while (!maximum.compareAndSet(current, value));
+	}
+
+	private static void require(boolean condition, String message)
+	{
+		if (!condition)
+		{
+			throw new AssertionError(message);
+		}
+	}
+}

diff --git a/TwitterGatherDataFollowers/Test/MlpModelAveragerSelfTest.java b/TwitterGatherDataFollowers/Test/MlpModelAveragerSelfTest.java
new file mode 100644
index 0000000..65779ac
--- BEFORE/TwitterGatherDataFollowers/Test/MlpModelAveragerSelfTest.java
+++ AFTER/TwitterGatherDataFollowers/Test/MlpModelAveragerSelfTest.java
@@ -0,0 +1,105 @@
+package TwitterGatherDataFollowers.userRyersonU;
+
+import java.io.File;
+import java.util.Arrays;
+
+import org.neuroph.core.Connection;
+import org.neuroph.core.Layer;
+import org.neuroph.core.NeuralNetwork;
+import org.neuroph.core.Neuron;
+import org.neuroph.core.Weight;
+import org.neuroph.nnet.MultiLayerPerceptron;
+import org.neuroph.util.TransferFunctionType;
+
+public final class MlpModelAveragerSelfTest
+{
+	private MlpModelAveragerSelfTest()
+	{
+	}
+
+	public static void main(String[] args)
+	{
+		File first = temporaryModelFile("first");
+		File second = temporaryModelFile("second");
+		File third = temporaryModelFile("third");
+		File averaged = temporaryModelFile("averaged");
+		try
+		{
+			saveConstantModel(first, 1.0);
+			saveConstantModel(second, 3.0);
+			saveConstantModel(third, 5.0);
+			MlpModelAverager.averageLegacyCompatible(
+					Arrays.asList(
+							first.getAbsolutePath(),
+							second.getAbsolutePath(),
+							third.getAbsolutePath()),
+					averaged.getAbsolutePath());
+
+			MultiLayerPerceptron result = (MultiLayerPerceptron)
+					NeuralNetwork.createFromFile(averaged.getAbsolutePath());
+			double expected = (3.0 + 8.0) / 3.0;
+			for (int layerIndex = 1;
+					layerIndex < result.getLayers().size(); layerIndex++)
+			{
+				Layer layer = result.getLayers().get(layerIndex);
+				for (Neuron neuron : layer.getNeurons())
+				{
+					for (Connection connection : neuron.getInputConnections())
+					{
+						require(Math.abs(connection.getWeight().getValue() - expected)
+								< 1.0e-12,
+								"streamed MLP average changed legacy weight behavior");
+					}
+				}
+			}
+			System.out.println("MlpModelAveragerSelfTest passed");
+		}
+		finally
+		{
+			first.delete();
+			second.delete();
+			third.delete();
+			averaged.delete();
+		}
+	}
+
+	private static void saveConstantModel(File file, double value)
+	{
+		MultiLayerPerceptron model =
+				new MultiLayerPerceptron(TransferFunctionType.TANH, 3, 2, 2);
+		for (int layerIndex = 1;
+				layerIndex < model.getLayers().size(); layerIndex++)
+		{
+			for (Neuron neuron : model.getLayers().get(layerIndex).getNeurons())
+			{
+				for (Connection connection : neuron.getInputConnections())
+				{
+					connection.setWeight(new Weight(value));
+				}
+			}
+		}
+		model.save(file.getAbsolutePath());
+	}
+
+	private static File temporaryModelFile(String label)
+	{
+		try
+		{
+			File file = File.createTempFile("mlp-"+label, ".nnet");
+			file.delete();
+			return file;
+		}
+		catch (java.io.IOException e)
+		{
+			throw new RuntimeException(e);
+		}
+	}
+
+	private static void require(boolean condition, String message)
+	{
+		if (!condition)
+		{
+			throw new AssertionError(message);
+		}
+	}
+}

