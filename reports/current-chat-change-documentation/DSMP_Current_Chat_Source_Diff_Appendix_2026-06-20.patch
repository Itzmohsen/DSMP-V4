+
+        private static int inferColumn(SourceProfile source, int dsmpNoHeaderIndex, String... names) {
+            int named = source.columnIndex(names);
+            if (named >= 0) {
+                return named;
+            }
+            if (!source.hasHeader && source.columnNames.size() >= 6
