+				boolean removeRetweets,
+				boolean removeStopWords,
+				boolean simulateDelay,
+				boolean graphEnabled,
+				String parameterProfile,
+				String parameterSummary,
+				String selectedTargets)
+		{
+			this.algorithm = algorithm;
